---
// Astro 컴파일러는 마크다운 파일을 파싱할 때 frontmatter 뿐만 아니라, 
// 문서 내의 모든 제목(h1~h6)을 추출하여 'headings'라는 배열(Array) 객체로 넘겨줍니다.
const { frontmatter, headings } = Astro.props;
---

<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title} | Silicon Archive</title>
    <style>
        /* [1. IDE Base Environment] */
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;600;800&display=swap');

        body, html {
            margin: 0;
            padding: 0;
            height: 100vh;
            background-color: #0D1117; /* GitHub Dark / 차가운 네이비 블랙 */
            color: #C9D1D9; /* 밝은 회색 텍스트 */
            font-family: 'Inter', sans-serif;
            overflow: hidden; /* 전체 페이지 스크롤 방지, 내부 분할 스크롤 적용 */
        }

        /* [2. Split Screen Architecture (MUX)] */
        .tech-container {
            display: grid;
            grid-template-columns: 280px 1fr; /* 좌측 TOC 280px 고정, 우측은 나머지 전부 */
            height: 100vh;
        }

        /* [3. Left Sidebar (TOC Router)] */
        .sidebar {
            background-color: #161B22;
            border-right: 1px solid #30363D;
            padding: 2rem 1.5rem;
            overflow-y: auto;
        }

        .nav-back {
            display: block;
            font-family: 'JetBrains Mono', monospace;
            color: #58A6FF;
            text-decoration: none;
            font-size: 0.85rem;
            margin-bottom: 3rem;
        }

        .nav-back:hover { text-decoration: underline; }

        .toc-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            color: #8B949E;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            border-bottom: 1px solid #30363D;
            padding-bottom: 0.5rem;
        }

        .toc-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        /* Depth(h2, h3)에 따른 들여쓰기 연산 */
        .toc-item { margin-bottom: 0.6rem; }
        .depth-2 { margin-left: 0; font-weight: 600; }
        .depth-3 { margin-left: 1rem; font-size: 0.9rem; color: #8B949E; }
        .depth-4 { margin-left: 2rem; font-size: 0.85rem; color: #8B949E; }

        .toc-link {
            text-decoration: none;
            color: inherit;
            transition: color 0.2s;
        }

        .toc-link:hover { color: #58A6FF; }

        /* [4. Right Main Data Path (Content)] */
        .main-content {
            padding: 4rem;
            overflow-y: auto; /* 내용이 길면 우측 패널만 스크롤됨 */
            scroll-behavior: smooth;
        }

        .article-body {
            max-width: 800px;
            margin: 0 auto;
        }

        /* 마크다운 내부 요소 CSS 제어 */
        h1 { font-size: 2.5rem; color: #FFF; margin-bottom: 0.5rem; }
        .date-badge { font-family: 'JetBrains Mono', monospace; color: #8B949E; font-size: 0.9rem; margin-bottom: 3rem; display: inline-block; }
        
        h2, h3 { color: #58A6FF; margin-top: 2.5rem; border-bottom: 1px solid #30363D; padding-bottom: 0.5rem; }
        
        /* 인라인 코드 및 코드 블록 처리 */
        code {
            font-family: 'JetBrains Mono', monospace;
            background-color: rgba(110, 118, 129, 0.4);
            padding: 0.2em 0.4em;
            border-radius: 4px;
            font-size: 0.9em;
        }
        pre {
            background-color: #010409 !important;
            padding: 1.5rem;
            border-radius: 6px;
            border: 1px solid #30363D;
            overflow-x: auto;
            margin: 1.5rem 0;
        }
        pre code { background-color: transparent; padding: 0; }
    </style>
</head>
<body>

    <div class="tech-container">
        <aside class="sidebar">
            <a href="/" class="nav-back">< Return to Root</a>
            <div class="toc-title">Index Tree</div>
            <ul class="toc-list">
                {headings.map((heading) => (
                    <li class={`toc-item depth-${heading.depth}`}>
                        <a href={`#${heading.slug}`} class="toc-link">
                            {heading.text}
                        </a>
                    </li>
                ))}
            </ul>
        </aside>

        <main class="main-content">
            <article class="article-body">
                <h1>{frontmatter.title}</h1>
                <div class="date-badge">{frontmatter.date}</div>
                
                <slot />
            </article>
        </main>
    </div>

</body>
</html>
