---
// 마크다운 파일의 상단 데이터(Frontmatter)를 받아오는 인터페이스(Interface)입니다.
const { frontmatter } = Astro.props;
---

<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title} | Analog Log</title>
    <style>
        /* [1. Typography & Colors] */
        @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600&display=swap');

        body, html {
            margin: 0;
            padding: 0;
            background-color: #F4EBD0; /* 따뜻한 양피지 질감의 상아색 */
            color: #4A3F35; /* 에스프레소 브라운 */
            font-family: 'Noto Serif KR', serif;
            line-height: 1.8;
            word-break: keep-all;
        }

        /* [2. Layout Grid] */
        .log-container {
            max-width: 650px;
            margin: 5rem auto;
            padding: 0 2rem;
        }

        /* [3. Navigation] */
        .nav-header {
            margin-bottom: 4rem;
            border-bottom: 1px solid #E0D5B7;
            padding-bottom: 1rem;
        }

        .nav-back {
            color: #8C6F56;
            text-decoration: none;
            font-size: 0.95rem;
            font-style: italic;
            transition: color 0.3s;
        }

        .nav-back:hover {
            color: #4A3F35;
        }

        /* [4. Post Metadata] */
        .post-title {
            font-size: 2.2rem;
            font-weight: 600;
            color: #2C2621;
            margin-bottom: 0.5rem;
            line-height: 1.3;
        }

        .post-date {
            font-size: 0.9rem;
            color: #8C6F56;
            margin-bottom: 3rem;
        }

        /* [5. Markdown Content Injection Area] */
        .content {
            font-size: 1.05rem;
        }
        
        .content p {
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="log-container">
        <nav class="nav-header">
            <a href="/" class="nav-back">← Back to the Hub</a>
        </nav>

        <h1 class="post-title">{frontmatter.title}</h1>
        <p class="post-date">{frontmatter.date}</p>

        <div class="content">
            <slot />
        </div>
    </div>

</body>
</html>
