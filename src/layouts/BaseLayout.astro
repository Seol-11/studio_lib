---
// src/layouts/BaseLayout.astro
import { ClientRouter } from 'astro:transitions';
import LogWidget from '../components/LogWidget.astro';
import '../styles/style_config.css';

export interface Props {
    title?: string;
    description?: string;
}

const { 
    title = "Studio.lib | System Router",
    description = "Hardware architectures and Digital Logic Portfolio"
} = Astro.props;
---
<!DOCTYPE html> <html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <script is:inline>
        const setTheme = () => {
            const theme = (() => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            })();
            if (theme === 'dark') document.documentElement.classList.add('dark');
            else document.documentElement.classList.remove('dark');
        };

        // Run immediately on initial load
        setTheme();

        // Handle View Transitions theme persistence
        document.addEventListener('astro:before-swap', (ev) => {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
                ev.newDocument.documentElement.classList.add('dark');
            } else {
                ev.newDocument.documentElement.classList.remove('dark');
            }
        });
    </script>

    <script>
        const setupMarkdown = () => {
            // Table responsive wrapper
            const tables = document.querySelectorAll('.sl-markdown-content table');
            tables.forEach(table => {
                if (table.parentElement.classList.contains('table-wrapper')) return;
                const wrapper = document.createElement('div');
                wrapper.className = 'table-wrapper';
                table.parentNode.insertBefore(wrapper, table);
                wrapper.appendChild(table);
            });
        };

        // Run on initial load and after each navigation
        document.addEventListener('astro:page-load', setupMarkdown);
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    
    <ClientRouter />
    </head>
    <body transition:animate="none">
    <slot />
    <LogWidget />
    </body>
    </html>

<style is:global>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    /* 테마 전환 중에는 모든 애니메이션 즉시 제거 */
    html.theme-toggling * {
        transition: none !important;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        font-family: var(--font-sans);
        background-color: var(--bg-color);
        color: var(--foreground);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }

    html {
        overflow-y: scroll;
        scroll-behavior: smooth;
    }

    /* Common Category/Listing Header Styles */
    .category-header {
        margin-bottom: 1.25rem;
        padding-bottom: 0.5rem;
    }
    .category-title {
        font-size: 1.75rem !important;
        font-weight: 600 !important;
        margin: 0 0 0.5rem 0 !important;
        letter-spacing: var(--tracking-tight) !important;
        color: var(--foreground);
    }
    .category-header .category-meta {
        color: var(--muted-foreground);
        font-size: 0.9375rem;
        margin: 0 !important;
    }

    /* Unified Pagination Styles */
    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.25rem;
        margin-top: 2rem;
        padding-bottom: 0;
    }

    .page-btn {
        background: transparent;
        border: none;
        color: var(--muted-foreground);
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        padding: 0.375rem 0.75rem;
        border-radius: var(--radius);
        transition: all 0.15s;
    }

    .page-btn:hover:not([disabled]) {
        color: var(--foreground);
        background-color: var(--muted);
    }

    .page-btn.active {
        color: var(--signature-color);
        background-color: var(--muted);
        font-weight: 700;
    }

    .page-btn[disabled] {
        opacity: 0.3;
        cursor: not-allowed;
    }

    @media (max-width: 600px) {
        .category-title {
            font-size: 1.5rem !important;
        }
        .category-header {
            margin-bottom: 1rem;
        }
    }

    /* Disable all view transitions animations globally */
    ::view-transition-group(root),
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
        animation-duration: 0s !important;
        animation-name: none !important;
    }

    /* Disable view transitions on mobile for immediate changes */
    @media (max-width: 768px) {
        ::view-transition-group(root),
        ::view-transition-old(root),
        ::view-transition-new(root) {
            animation-duration: 0s !important;
            animation-name: none !important;
        }
    }
</style>