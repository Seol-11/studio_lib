---
// src/layouts/BaseLayout.astro
import { ClientRouter } from 'astro:transitions';
import LogWidget from '../components/LogWidget.astro';

export interface Props {
    title?: string;
    description?: string;
}

const { 
    title = "Studio.lib | System Router",
    description = "Hardware architectures and Digital Logic Portfolio"
} = Astro.props;
---
<!DOCTYPE html> <html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <script is:inline>
        const applyTheme = () => {
            const theme = (() => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            })();
            if (theme === 'dark') document.documentElement.classList.add('dark');
            else document.documentElement.classList.remove('dark');
        };

        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    
    <ClientRouter />
    </head>
    <body>
    <slot />
    <LogWidget />
    </body>
    </html>

<style is:global>
    :root {
        --font-sans: 'Inter', 'Pretendard', ui-sans-serif, system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, menlo, monaco, consolas, monospace;

        --bg-color: #ffffff;
        --foreground: #0a0a0a;
        --border-color: #e5e5e5;
        --muted: #f5f5f5;
        --muted-foreground: #737373;
        --accent: #f5f5f5;
        --accent-foreground: #0a0a0a;
        --signature-color: #84a98c;

        --radius: 0.5rem;
        --tracking-tight: -0.025em;
    }

    html.dark {
        --bg-color: #1a1a1a;
        --foreground: #ececec;
        --border-color: #2e2e2e;
        --muted: #262626;
        --muted-foreground: #9a9a9a;
        --accent: #262626;
        --accent-foreground: #ececec;
        --signature-color: #a1cca5;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        font-family: var(--font-sans);
        background-color: var(--bg-color);
        color: var(--foreground);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }

    html {
        overflow-y: scroll;
        scroll-behavior: smooth;
    }

    /* Common Markdown Content Styles */
    .sl-markdown-content {
        font-family: 'Pretendard', var(--font-sans);
        letter-spacing: 0;
        word-break: keep-all;
        font-size: clamp(0.9375rem, 0.915rem + 0.1vw, 1rem);
    }

    .sl-markdown-content strong,
    .sl-markdown-content b {
        font-weight: 550;
    }

    .sl-markdown-content :is(h1, h2, h3, h4, h5, h6) {
        font-weight: 500;
        letter-spacing: var(--tracking-tight);
        color: var(--foreground);
    }

    .sl-markdown-content h1 {
        font-size: 1.75rem;
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: 1rem;
    }

    .sl-markdown-content h2 {
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.4;
        margin-top: 3rem;
        padding-top: 1rem;
        padding-bottom: 0.5rem;
    }

    .sl-markdown-content h3 {
        font-size: 1.125rem;
        margin-top: 2.25rem;
    }

    .sl-markdown-content p {
        line-height: 1.82;
        margin-bottom: 1.5rem;
        color: var(--foreground);
    }

    @media (max-width: 600px) {
        .sl-markdown-content p {
            line-height: 1.77;
            margin-bottom: 1.25rem;
        }
        .sl-markdown-content h2 { margin-top: 2.5rem; }
    }

    .sl-markdown-content a:not([class]) {
        text-decoration: underline;
        text-underline-offset: 0.25rem;
        text-decoration-color: var(--signature-color);
        color: var(--signature-color);
        font-weight: 500;
        transition: color 0.15s, text-decoration-color 0.15s;
    }

    .sl-markdown-content blockquote {
        border-left: 4px solid var(--signature-color);
        padding: 0.5rem 1rem;
        color: var(--muted-foreground);
        background: var(--muted);
        margin: 1.5rem 0;
        border-radius: 0 var(--radius) var(--radius) 0;
        font-style: italic;
    }

    .sl-markdown-content ul, .sl-markdown-content ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }

    .sl-markdown-content li {
        margin-bottom: 0.5rem;
        line-height: 1.75;
    }

    .sl-markdown-content pre {
        background-color: #0a0a0a !important;
        color: #fafafa;
        padding: 1.5rem;
        border-radius: var(--radius);
        margin: 1.5rem 0;
        border: 1px solid var(--border-color);
        font-size: 0.875rem;
        line-height: 1.6;
    }

    .sl-markdown-content img {
        max-width: 100%;
        border-radius: var(--radius);
        margin: 1.5rem 0;
        border: 1px solid var(--border-color);
    }

    /* Common Category/Listing Header Styles */
    .category-header {
        margin-bottom: 1.25rem;
        padding-bottom: 0.5rem;
    }
    .category-title {
        font-size: 1.75rem !important;
        font-weight: 600 !important;
        margin: 0 0 0.5rem 0 !important;
        letter-spacing: var(--tracking-tight) !important;
        color: var(--foreground);
    }
    .category-meta {
        color: var(--muted-foreground);
        font-size: 0.9375rem;
        margin: 0 !important;
    }

    /* Unified Pagination Styles */
    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.25rem;
        margin-top: 2rem;
        padding-bottom: 0;
    }

    .page-btn {
        background: transparent;
        border: none;
        color: var(--muted-foreground);
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        padding: 0.375rem 0.75rem;
        border-radius: var(--radius);
        transition: all 0.15s;
    }

    .page-btn:hover:not([disabled]) {
        color: var(--foreground);
        background-color: var(--muted);
    }

    .page-btn.active {
        color: var(--signature-color);
        background-color: var(--muted);
        font-weight: 700;
    }

    .page-btn[disabled] {
        opacity: 0.3;
        cursor: not-allowed;
    }

    @media (max-width: 600px) {
        .category-title {
            font-size: 1.5rem !important;
        }
        .category-header {
            margin-bottom: 1rem;
        }
    }

    /* Disable view transitions on mobile for immediate changes */
    @media (max-width: 768px) {
        ::view-transition-group(root),
        ::view-transition-old(root),
        ::view-transition-new(root) {
            animation-duration: 0s !important;
            animation-name: none !important;
        }
    }
</style>