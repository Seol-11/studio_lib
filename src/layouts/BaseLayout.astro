---
// src/layouts/BaseLayout.astro
const { title = "Studio.lib" } = Astro.props;
---
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Noto+Serif+KR:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <slot />
</body>
</html>

<style is:global>
    /* is:global 속성을 사용하여 하위 컴포넌트 전체에 적용되는 공용 스타일 정의 */
    body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        background-color: #F4EBD0; 
        color: #4A3F35; 
        font-family: 'Noto Serif KR', serif; 
    }
</style>