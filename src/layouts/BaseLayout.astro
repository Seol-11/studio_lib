---
// src/layouts/BaseLayout.astro
import LogWidget from '../components/LogWidget.astro';

export interface Props {
    title?: string;
    description?: string;
}

const { 
    title = "Studio.lib | System Router",
    description = "Hardware architectures and Digital Logic Portfolio"
} = Astro.props;
---
<!DOCTYPE html> <html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <script is:inline>
        const theme = (() => {
            if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                return localStorage.getItem('theme');
            }
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        })();
        if (theme === 'dark') document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">
    </head>
    <body>
    <slot />
    <LogWidget />
    </body>
    </html>

    <style is:global>
    :root {
        /* Lucode Starlight Theme Core Variables */
        --font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;

        /* Light Mode */
        --bg-color: #ffffff;
        --foreground: #0a0a0a;
        --border-color: #e5e5e5;
        --muted: #f5f5f5;
        --muted-foreground: #737373;
        --accent: #f5f5f5;
        --accent-foreground: #0a0a0a;
        --signature-color: #84a98c; /* Matcha point color */

        --radius: 0.5rem;
        --tracking-tight: -0.025em;
    }

    html.dark {
        --bg-color: #1a1a1a;
        --foreground: #ececec;
        --border-color: #2e2e2e;
        --muted: #262626;
        --muted-foreground: #9a9a9a;
        --accent: #262626;
        --accent-foreground: #ececec;
        --signature-color: #a1cca5; /* Brightened Matcha for dark mode */
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        font-family: var(--font-sans);
        background-color: var(--bg-color);
        color: var(--foreground);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    html {
        overflow-y: scroll;
        scroll-behavior: smooth;
    }
</style>
