---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import BlogSidebar from '../components/BlogSidebar.astro';

export interface Props {
    title?: string;
    description?: string;
    headings?: { depth: number; slug: string; text: string }[];
}

const { 
    title = "Blog | Studio.lib", 
    description = "Analog Log & Study Notes",
    headings 
} = Astro.props;
---
<BaseLayout title={title} description={description}>
    <Header />

    <div class="lucode-container">
        <!-- Left: Navigation Sidebar -->
        <BlogSidebar />

        <div class="lucode-main-wrapper">
            <!-- Center: Main Content -->
            <main class="lucode-content">
                <slot />
            </main>

            <!-- Right: TOC Sidebar -->
            <aside class="lucode-toc-sidebar">
                <div class="toc-inner">
                    <h2 class="group-title">ON_THIS_PAGE</h2>
                    {headings && headings.length > 0 ? (
                        <nav class="toc-nav">
                            {headings.map((heading) => (
                                <a href={`#${heading.slug}`} class={`toc-link depth-${heading.depth}`}>
                                    {heading.text}
                                </a>
                            ))}
                        </nav>
                    ) : (
                        <div class="toc-placeholder">index empty</div>
                    )}
                </div>
            </aside>
        </div>
    </div>

    <script is:inline>
        const initTOC = () => {
            const tocLinks = document.querySelectorAll('.toc-link');
            const contentHeadings = Array.from(document.querySelectorAll('.sl-markdown-content h1[id], .sl-markdown-content h2[id], .sl-markdown-content h3[id], .sl-markdown-content h4[id]'));
            
            if (tocLinks.length === 0) return;

            // Smooth Scroll
            tocLinks.forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    const targetId = link.getAttribute('href').substring(1);
                    const targetElement = document.getElementById(targetId);
                    
                    if (targetElement) {
                        const offset = 80;
                        const elementPosition = targetElement.getBoundingClientRect().top;
                        const offsetPosition = elementPosition + window.pageYOffset - offset;
                        
                        window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
                        window.history.replaceState(null, null, `#${targetId}`);
                    }
                });
            });

            // Intersection Observer for Active State
            const observerOptions = {
                rootMargin: '-80px 0px -70% 0px',
                threshold: 1.0
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id');
                        tocLinks.forEach(link => {
                            link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
                        });
                    }
                });
            }, observerOptions);

            contentHeadings.forEach(h => observer.observe(h));
        };

        document.addEventListener('astro:page-load', initTOC);
    </script>
</BaseLayout>

<style>
    .lucode-container {
        display: flex;
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        min-height: 100vh;
        padding-top: 3.5rem; /* Header height */
    }

    /* main wrapper constraints center content and right TOC */
    .lucode-main-wrapper {
        flex: 1;
        display: flex;
        min-width: 0;
    }

    .lucode-content {
        flex: 1;
        min-width: 0;
        max-width: 900px;
        margin: 0 auto;
        padding: 4rem 4rem 6rem;
    }

    .lucode-toc-sidebar {
        display: none;
        width: 18rem;
        flex-shrink: 0;
        position: sticky;
        top: 3.5rem;
        height: calc(100vh - 3.5rem);
        overflow-y: auto;
        padding: 3rem 2rem 3rem 2rem;
        border-left: none; /* Removed border */
    }

    @media (min-width: 1280px) {
        .lucode-toc-sidebar {
            display: block;
        }
    }

    .group-title {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--foreground);
        opacity: 0.6;
        margin-bottom: 1rem;
        letter-spacing: 1px;
    }

    .toc-nav {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .toc-link {
        font-size: 0.8rem; /* Decreased font size */
        color: var(--muted-foreground);
        text-decoration: none;
        line-height: 1.4;
        transition: color 0.15s;
        border-left: none; /* Removed border */
        padding-left: 0; /* Adjusted padding */
        margin-left: 0;
    }

    .toc-link:hover {
        color: var(--foreground);
    }

    .toc-link.active {
        color: var(--signature-color);
        font-weight: 600;
    }

    .toc-link.depth-3 { padding-left: 0.8rem; }
    .toc-link.depth-4 { padding-left: 1.6rem; }

    .toc-placeholder {
        font-size: 0.8rem;
        color: var(--muted-foreground);
        font-style: italic;
    }

    @media (max-width: 1024px) {
        .lucode-container {
            flex-direction: column;
        }
    }

    @media (max-width: 768px) {
        .lucode-content {
            padding: 2rem 1.5rem 4rem;
        }
    }
</style>