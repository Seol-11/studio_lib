---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import BlogSidebar from '../components/BlogSidebar.astro';

export interface Props {
    title?: string;
    description?: string;
    headings?: { depth: number; slug: string; text: string }[];
}

const { 
    title = "Blog | Studio.lib", 
    description = "Analog Log & Study Notes",
    headings 
} = Astro.props;
---
<BaseLayout title={title} description={description}>
    <Header />

    <div class="blog-wrapper">
        <div class="blog-container">
            
            <!-- Left: Index Navigation Component -->
            <BlogSidebar />

            <!-- Center: Main Content -->
            <main class="main-content">
                <slot />
            </main>

            <!-- Right: Extra / TOC placeholder -->
            <aside class="right-sidebar">
                <div class="toc-container">
                    <div class="group-title">ON_THIS_PAGE</div>
                    {headings && headings.length > 0 ? (
                        <nav class="toc-nav">
                            {headings.map((heading) => (
                                <a href={`#${heading.slug}`} class={`toc-link depth-${heading.depth}`}>
                                    {heading.text}
                                </a>
                            ))}
                        </nav>
                    ) : (
                        <div class="toc-placeholder">
                            <span>Index empty</span>
                        </div>
                    )}
                </div>
            </aside>

        </div>
    </div>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // TOC Smooth scroll & history state prevention
            const tocLinks = document.querySelectorAll('.toc-link');
            tocLinks.forEach(link => {
                link.addEventListener('click', (e) => {
                    // Astro.js의 기본 라우팅이나 브라우저 기본 동작 완벽 차단
                    e.preventDefault();
                    e.stopPropagation();

                    const targetId = link.getAttribute('href').substring(1);
                    const targetElement = document.getElementById(targetId);
                    
                    if (targetElement) {
                        targetElement.scrollIntoView({ behavior: 'smooth' });
                        // history.pushState 대신 replaceState를 사용하여 뒤로가기 스택에 쌓이지 않게 함
                        window.history.replaceState(null, null, `#${targetId}`);
                    }
                });
            });
        });
    </script>
</BaseLayout>

<style is:global>
    /* Global Theme Variables for Blog */
    :root {
        --bg-color: #FDFCF8;
        --container-bg: rgba(255, 255, 255, 0.6);
        --text-primary: #111;
        --text-secondary: #666;
        --border-color: rgba(0, 0, 0, 0.08);
        --hover-bg: rgba(0, 0, 0, 0.04);
        --accent-color: #333;
    }

    html.dark {
        --bg-color: #121212; 
        --container-bg: rgba(30, 30, 30, 0.6); 
        --text-primary: #EEEEEE; 
        --text-secondary: #999999; 
        --border-color: rgba(255, 255, 255, 0.08); 
        --hover-bg: rgba(255, 255, 255, 0.04);
        --accent-color: #ccc;
    }

    body {
        background: var(--bg-color);
        color: var(--text-primary);
        transition: background-color 0.3s ease;
    }
</style>

<style>
    .blog-wrapper {
        min-height: 100vh;
        padding-top: 60px; /* Header offset */
        display: flex;
        justify-content: center;
    }

    .blog-container {
        width: 100%;
        max-width: 1400px;
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr) 240px;
        gap: 3rem;
        padding: 3rem 2rem;
        align-items: start; /* Grid item 높이를 내용물에 맞추어 sticky 작동 보장 */
    }

    /* Main Content */
    .main-content {
        min-width: 0;
        padding: 0; /* 좌우 여백 없이 타이포그래피 집중 */
    }

    .right-sidebar {
        position: sticky;
        top: calc(60px + 3rem); /* 헤더 높이(60px) + 컨테이너 상단 여백(3rem). 0px 유격 완벽 고정 */
        align-self: start;
        height: max-content;
        max-height: calc(100vh - 60px - 3rem - 2rem); /* 뷰포트 하단 여백 확보 */
        overflow-y: auto;
        padding-right: 1rem;
        scrollbar-width: none; /* 사이드바 스크롤바 숨김 */
    }
    .right-sidebar::-webkit-scrollbar {
        display: none;
    }

    .group-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-secondary);
        margin-bottom: 1rem;
        letter-spacing: 1.5px;
    }

    /* TOC Styles */
    .toc-nav {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .toc-link {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.85rem;
        line-height: 1.4;
        transition: color 0.2s ease;
    }
    .toc-link:hover {
        color: var(--text-primary);
    }
    .toc-link.depth-2 { padding-left: 0; font-weight: 700; }
    .toc-link.depth-3 { padding-left: 0.8rem; }
    .toc-link.depth-4 { padding-left: 1.6rem; }

    /* Main Content */
    .main-content {
        min-width: 0;
        padding: 3rem 0; /* 심플한 타이포그래피 집중을 위해 좌우 여백을 없애고 위아래 여백만 유지 */
    }

    .toc-placeholder {
        font-size: 0.85rem;
        color: var(--text-secondary);
        font-style: italic;
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .blog-container {
            grid-template-columns: 220px minmax(0, 1fr);
        }
        .right-sidebar {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .blog-container {
            grid-template-columns: minmax(0, 1fr);
            padding: 2rem 1.5rem;
        }
        .main-content {
            padding: 1rem 0;
        }
    }
</style>