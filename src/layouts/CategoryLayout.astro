---
import BlogLayout from './BlogLayout.astro';
import PostList from '../components/PostList.astro';

const { frontmatter } = Astro.props;

// 모든 블로그 포스트 가져오기
const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true })) as any[];

// 메인 화면용, 카테고리용 md 파일 제외, 그리고 이 카테고리에 맞는 포스트만 필터링
const posts = allPosts.filter(post => {
    if (post.file.endsWith('_blog-index.md') || post.frontmatter.isCategory) return false;
    
    const postCategory = post.frontmatter.category;
    if (!postCategory) return false;
    
    if (Array.isArray(postCategory)) {
        return postCategory.includes(frontmatter.categoryId);
    }
    return postCategory === frontmatter.categoryId;
});

// 최신순 정렬
const sortedPosts = posts.sort((a, b) => {
    const dateA = new Date(a.frontmatter.date || 0).valueOf();
    const dateB = new Date(b.frontmatter.date || 0).valueOf();
    return dateB - dateA;
});
---

<BlogLayout title={`${frontmatter.title} | Studio.lib`} description={frontmatter.description}>
    <div class="sl-markdown-content">
        <header class="category-header">
            <h1 class="category-title" id="_top">{frontmatter.title}</h1>
            {frontmatter.description && <p class="category-meta">{frontmatter.description}</p>}
        </header>
        
        <div class="category-intro-content">
            <slot />
        </div>

        <div class="category-posts-section">
            <h2 id="related-posts">Related Posts</h2>
            <PostList posts={sortedPosts} />
        </div>
    </div>
</BlogLayout>

<style>
    .category-header {
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
    }
    .category-title {
        font-size: 1.75rem !important; /* Slightly increased from 1.625rem */
        font-weight: 600 !important;
        margin: 0 0 0.5rem 0 !important;
        letter-spacing: var(--tracking-tight) !important;
    }
    .category-meta {
        color: var(--muted-foreground);
        font-size: 0.9375rem;
        margin: 0 !important;
    }
    .category-intro-content {
        margin-bottom: 0.5rem;
    }
    .category-posts-section {
        margin-top: 0;
        padding-top: 0;
    }

    @media (max-width: 600px) {
        .category-title {
            font-size: 1.5rem !important;
        }
        .category-header {
            margin-bottom: 0.75rem;
            padding-bottom: 0.25rem;
        }
    }
</style>