---
import BlogLayout from './BlogLayout.astro';
import PostList from '../components/PostList.astro';
import GiscusComments from '../components/GiscusComments.astro';
import { getCollection } from 'astro:content';
import { collectionEntryToPost, getCategoryPath, isPublishedPost, normalizePath, sortPostsByDate } from '../utils/posts';

const { frontmatter, headings } = Astro.props;
const heroImage = frontmatter.heroImage && !['none', 'false', 'null'].includes(String(frontmatter.heroImage).toLowerCase())
    ? frontmatter.heroImage
    : undefined;

if (import.meta.env.PROD && frontmatter.draft) {
    return Astro.redirect('/404');
}

// 같은 카테고리의 포스트들을 불러오기
const allPosts = (await getCollection('posts')).map(collectionEntryToPost);
const currentPath = normalizePath(Astro.url.pathname);
const currentCategoryPath = getCategoryPath(currentPath);

const categoryPosts = sortPostsByDate(allPosts.filter((post) =>
    isPublishedPost(post)
    && currentCategoryPath !== null
    && normalizePath(post.url) !== currentPath
    && getCategoryPath(post.url) === currentCategoryPath,
));
---
<BlogLayout title={`${frontmatter.title} | Studio.lib`} description={frontmatter.description} headings={headings} pageType="article" image={heroImage}>
    <article class="blog-post">
        <header class="post-header">
            <h1 id="_top" class="post-heading">{frontmatter.title}</h1>
            {frontmatter.hide && <span class="hide-label">HIDDEN</span>}
            <div class="post-meta">
                <span>{frontmatter.date}</span>
                {frontmatter.tags && frontmatter.tags.map((tag: string) => (
                    <span class="tag">#{tag}</span>
                ))}
            </div>
        </header>
        
        <div class="post-content sl-markdown-content">
            {heroImage && (
                <img class="hero-image" src={heroImage} alt="" width="1200" height="676" decoding="async" fetchpriority="high" />
            )}
            <slot />
        </div>

        <div class="comments-section">
            <h2 id="comments" class="post-section-heading">Comments</h2>
            <GiscusComments />
        </div>

        {categoryPosts.length > 0 && (
            <div class="category-posts-section">
                <h2 id="more-posts" class="post-section-heading">More Posts</h2>
                <PostList posts={categoryPosts} />
            </div>
        )}
    </article>
</BlogLayout>

<style>
    /* Layout specific styles for blog posts */
    .post-header { margin-bottom: 3rem; position: relative; }
    .post-heading {
        margin: 0;
        color: var(--foreground);
        font-family: var(--font-sans);
        font-size: var(--font-size-h1);
        font-weight: var(--weight-semibold);
        line-height: var(--leading-tight);
        letter-spacing: var(--tracking-tight);
        overflow-wrap: break-word;
    }
    .hide-label {
        display: inline-block;
        background-color: #ffeb3b;
        color: #000;
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        font-weight: bold;
        border-radius: 4px;
        margin-top: 0.5rem;
        vertical-align: middle;
    }
    .post-meta {
        display: flex;
        gap: 0.5rem 1rem;
        flex-wrap: wrap;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--muted-foreground);
        margin-top: 1rem;
    }
    .category-posts-section, .comments-section {
        margin-top: 0.5rem;
        padding-top: 0.5rem;
    }
    .post-section-heading {
        margin: 2.75rem 0 1rem;
        color: var(--foreground);
        font-family: var(--font-sans);
        font-size: var(--font-size-h2);
        font-weight: var(--weight-semibold);
        line-height: var(--leading-snug);
        letter-spacing: var(--tracking-tight);
    }
    .hero-image {
        width: 100%;
        height: auto;
        aspect-ratio: 1200 / 676;
        object-fit: cover;
        border-radius: var(--radius);
    }
</style>
