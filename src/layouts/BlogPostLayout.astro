---
import BlogLayout from './BlogLayout.astro';
import PostList from '../components/PostList.astro';

const { frontmatter, headings } = Astro.props;

// 같은 카테고리의 포스트들을 불러오기
const allPosts = await Astro.glob('../pages/blog/**/*.md');
const currentPath = Astro.url.pathname;

const categoryPosts = allPosts.filter(post => {
    // 인덱스 및 카테고리 대문 파일 제외
    if (post.file.endsWith('_blog-index.md') || post.frontmatter.isCategory) return false;
    
    // 현재 보고 있는 글은 리스트에서 제외
    if (currentPath === post.url || currentPath === post.url + '/') return false;

    // 현재 글과 카테고리가 같은 글만 필터링
    return post.frontmatter.category && frontmatter.category && 
           post.frontmatter.category === frontmatter.category;
})
.sort((a, b) => new Date(b.frontmatter.date || 0).valueOf() - new Date(a.frontmatter.date || 0).valueOf());
---
<BlogLayout title={`${frontmatter.title} | Studio.lib`} description={frontmatter.description} headings={headings}>
    <article class="markdown-body">
        <header class="post-header">
            <h1 class="post-title">{frontmatter.title}</h1>
            <div class="post-meta">
                <span class="date">{frontmatter.date}</span>
                {frontmatter.tags && frontmatter.tags.map((tag: string) => (
                    <span class="tag">#{tag}</span>
                ))}
            </div>
            {frontmatter.heroImage && (
                <div class="hero-image-container">
                    <img src={frontmatter.heroImage} alt={frontmatter.title} class="hero-image" />
                </div>
            )}
        </header>
        
        <div class="post-content">
            <slot />
        </div>

        {/* 지스커스 (Giscus) 댓글창 */}
        <div class="comments-section">
            <h3 class="section-subtitle">Comments</h3>
            <p class="giscus-notice">※ <code>src/layouts/BlogPostLayout.astro</code> 하단에서 Giscus 저장소 정보를 본인 Github에 맞게 수정해주세요.</p>
            <script src="https://giscus.app/client.js"
                data-repo="[ENTER REPO HERE]"
                data-repo-id="[ENTER REPO ID HERE]"
                data-category="[ENTER CATEGORY HERE]"
                data-category-id="[ENTER CATEGORY ID HERE]"
                data-mapping="pathname"
                data-strict="0"
                data-reactions-enabled="1"
                data-emit-metadata="0"
                data-input-position="bottom"
                data-theme="preferred_color_scheme"
                data-lang="ko"
                crossorigin="anonymous"
                async>
            </script>
        </div>

        {/* 카테고리 내 다른 글 목록 */}
        {categoryPosts.length > 0 && (
            <div class="category-posts-section">
                <h3 class="section-subtitle">More from this category</h3>
                <PostList posts={categoryPosts} />
            </div>
        )}
    </article>
</BlogLayout>

<style is:global>
    .markdown-body {
        max-width: 800px;
        margin: 0 auto;
    }
    .post-header {
        margin-bottom: 3rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 2rem;
    }
    .post-title {
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 1rem 0;
        line-height: 1.2;
        letter-spacing: -0.5px;
    }
    .post-meta {
        display: flex;
        gap: 1rem;
        align-items: center;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: var(--text-secondary);
    }
    .post-meta .tag {
        background: transparent;
        border: 1px solid var(--signature-color);
        color: var(--signature-color);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
    }

    .hero-image-container {
        margin-top: 2rem;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-color);
    }
    .hero-image {
        width: 100%;
        height: auto;
        display: block;
        max-height: 400px;
        object-fit: cover;
    }

    /* Markdown Content Styling */
    .post-content {
        line-height: 1.7;
        font-size: 1.05rem;
        color: var(--text-primary);
    }
    .post-content h1, .post-content h2, .post-content h3, .post-content h4, .post-content h5, .post-content h6 {
        scroll-margin-top: 100px; /* 헤더 60px + 여백 40px */
    }
    .post-content h2 {
        font-size: 1.8rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }
    .post-content h3 {
        font-size: 1.4rem;
        margin-top: 2rem;
        margin-bottom: 0.8rem;
        font-weight: 700;
    }
    .post-content p {
        margin-bottom: 1.5rem;
    }
    .post-content a {
        color: var(--signature-color);
        text-decoration: underline;
        text-underline-offset: 4px;
    }
    .post-content ul, .post-content ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }
    .post-content li {
        margin-bottom: 0.5rem;
    }
    .post-content blockquote {
        border-left: 4px solid var(--signature-color);
        padding-left: 1rem;
        color: var(--text-secondary);
        font-style: italic;
        margin: 1.5rem 0;
    }
    .post-content code {
        font-family: 'JetBrains Mono', monospace;
        background: var(--hover-bg, rgba(0,0,0,0.05));
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
    }
    .post-content pre {
        background: #1e1e1e;
        color: #d4d4d4;
        padding: 1.5rem;
        border-radius: 8px;
        overflow-x: auto;
        margin: 1.5rem 0;
    }
    .post-content pre code {
        background: transparent;
        padding: 0;
        color: inherit;
    }
    .post-content img {
        max-width: 100%;
        border-radius: 8px;
        margin: 1.5rem 0;
        border: 1px solid var(--border-color);
    }

    /* Category Posts & Comments Section */
    .category-posts-section, .comments-section {
        margin-top: 5rem;
        padding-top: 2rem;
        border-top: 1px dashed var(--border-color);
    }
    .section-subtitle {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        color: var(--text-primary);
    }
    .giscus-notice {
        font-size: 0.85rem;
        color: var(--text-secondary);
        background: var(--hover-bg);
        padding: 0.8rem;
        border-radius: 6px;
        margin-bottom: 2rem;
    }
</style>