---
import BlogLayout from './BlogLayout.astro';
import PostList from '../components/PostList.astro';

const { frontmatter, headings } = Astro.props;

// 같은 카테고리의 포스트들을 불러오기
const allPosts = await Astro.glob('../pages/**/*.md');
const currentPath = Astro.url.pathname;

const categoryPosts = allPosts.filter(post => {
    if (post.file.endsWith('_blog-index.md') || post.frontmatter.isCategory) return false;
    if (currentPath === post.url || currentPath === post.url + '/') return false;
    return post.frontmatter.category && frontmatter.category && 
           post.frontmatter.category === frontmatter.category;
})
.sort((a, b) => new Date(b.frontmatter.date || 0).valueOf() - new Date(a.frontmatter.date || 0).valueOf());
---
<BlogLayout title={`${frontmatter.title} | Studio.lib`} description={frontmatter.description} headings={headings}>
    <article class="sl-markdown-content">
        <header class="post-header">
            <h1 id="_top">{frontmatter.title}</h1>
            <div class="post-meta">
                <span>{frontmatter.date}</span>
                {frontmatter.tags && frontmatter.tags.map((tag: string) => (
                    <span class="tag">#{tag}</span>
                ))}
            </div>
            {frontmatter.heroImage && (
                <img src={frontmatter.heroImage} alt={frontmatter.title} class="hero-image" />
            )}
        </header>
        
        <div class="post-content">
            <slot />
        </div>

        <div class="comments-section">
            <h2 id="comments">Comments</h2>
            <script src="https://giscus.app/client.js"
                data-repo="[ENTER REPO HERE]"
                data-repo-id="[ENTER REPO ID HERE]"
                data-category="[ENTER CATEGORY HERE]"
                data-category-id="[ENTER CATEGORY ID HERE]"
                data-mapping="pathname"
                data-strict="0"
                data-reactions-enabled="1"
                data-emit-metadata="0"
                data-input-position="bottom"
                data-theme="preferred_color_scheme"
                data-lang="ko"
                crossorigin="anonymous"
                async>
            </script>
        </div>

        {categoryPosts.length > 0 && (
            <div class="category-posts-section">
                <h2 id="more-posts">More Posts</h2>
                <PostList posts={categoryPosts} />
            </div>
        )}
    </article>
</BlogLayout>

<style is:global>
    .sl-markdown-content * {
        @media (min-width: 40rem) {
            font-size: 14px; /* 0.875rem */
            line-height: 1.8;
        }
    }

    .sl-markdown-content :is(h1, h2, h3, h4, h5, h6) {
        font-weight: 500;
        letter-spacing: var(--tracking-tight);
        color: var(--foreground);
    }

    .sl-markdown-content h1 {
        font-size: 1.75rem;
        line-height: 2.25rem;
        font-weight: 600;
    }

    .sl-markdown-content h2 {
        font-size: 1.25rem;
        line-height: 1.75rem;
        padding-top: 1.5rem;
        margin-top: 4rem;
        padding-bottom: 0.5rem;
    }

    .sl-markdown-content h3 {
        font-size: 1.125rem;
        line-height: 1.75rem;
        margin-top: 2.5rem;
    }

    .sl-markdown-content h4 {
        font-size: 1rem;
        line-height: 1.5rem;
        margin-top: 1.5rem;
    }

    .sl-markdown-content p {
        margin-bottom: 1.5rem;
        color: var(--foreground);
    }

    @media (max-width: 600px) {
        .sl-markdown-content h1 { font-size: 1.5rem; line-height: 2rem; }
        .sl-markdown-content h2 { font-size: 1.2rem; line-height: 1.6rem; margin-top: 3rem; }
        .sl-markdown-content h3 { font-size: 1.05rem; line-height: 1.5rem; margin-top: 2rem; }
        .sl-markdown-content h4 { font-size: 0.95rem; }
        .sl-markdown-content p { font-size: 0.95rem; line-height: 1.6; }
    }

    .sl-markdown-content a:not([class]) {
        text-decoration: underline;
        text-underline-offset: 0.25rem;
        text-decoration-color: var(--signature-color);
        color: var(--signature-color);
        font-weight: 500;
        transition: color 0.15s, text-decoration-color 0.15s;
    }

    .sl-markdown-content a:not([class]):hover {
        color: var(--foreground);
        text-decoration-color: var(--foreground);
    }

    .sl-markdown-content blockquote {
        border-left: 4px solid var(--signature-color);
        padding: 0.5rem 1rem;
        color: var(--muted-foreground);
        background: var(--muted);
        margin: 1.5rem 0;
        border-radius: 0 var(--radius) var(--radius) 0;
        font-style: italic;
    }

    .sl-markdown-content ul, .sl-markdown-content ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }

    .sl-markdown-content li {
        margin-bottom: 0.5rem;
    }

    .sl-markdown-content :not(pre) > code {
        background: var(--muted);
        border: 1px solid var(--border-color);
        border-radius: calc(var(--radius) - 4px);
        padding: 0.25rem 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.875em;
        color: var(--signature-color);
    }

    .sl-markdown-content pre {
        background-color: #0a0a0a !important; /* Force dark code blocks */
        color: #fafafa;
        padding: 1.5rem;
        border-radius: var(--radius);
        overflow-x: auto;
        margin: 1.5rem 0;
        border: 1px solid var(--border-color);
    }

    .sl-markdown-content pre code {
        background: transparent;
        padding: 0;
        border: none;
        color: inherit;
        font-family: var(--font-mono);
        font-size: 0.875rem;
    }

    .sl-markdown-content img {
        max-width: 100%;
        border-radius: var(--radius);
        margin: 1.5rem 0;
        border: 1px solid var(--border-color);
    }
</style>

<style>
    .post-header {
        margin-bottom: 3rem;
    }

    .post-meta {
        display: flex;
        gap: 1rem;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--muted-foreground);
        margin-top: 1rem;
    }
    .post-meta .tag {
        color: var(--foreground);
    }

    .hero-image {
        width: 100%;
        height: auto;
        display: block;
        max-height: 400px;
        object-fit: cover;
        margin-top: 2rem;
    }

    .category-posts-section, .comments-section {
        margin-top: 0.5rem;
        padding-top: 0.5rem;
    }
</style>