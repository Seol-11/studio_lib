---
import BlogLayout from './BlogLayout.astro';
import PostList from '../components/PostList.astro';
import GiscusComments from '../components/GiscusComments.astro';
import { categories } from '../pages/_categories';

const { frontmatter, headings } = Astro.props;

// 모든 카테고리 경로 평탄화 (끝의 슬래시 제거하여 통일)
const allCategoryPaths = categories
    .filter(c => c.type === 'folder')
    .flatMap(c => (c as any).items ? (c as any).items.map((item: any) => item.path.replace(/\/$/, '')) : []);

function getCategoryPathFromUrl(url: string | undefined) {
    if (!url) return null;
    const normalizedUrl = url.replace(/\/$/, '');
    return allCategoryPaths
        .filter(catPath => normalizedUrl.startsWith(catPath))
        .sort((a, b) => b.length - a.length)[0] || null;
}

// 같은 카테고리의 포스트들을 불러오기
const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true })) as any[];
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const currentCategoryPath = getCategoryPathFromUrl(currentPath);

const categoryPosts = allPosts.filter(post => {
    const fileName = post.file.split('/').pop();
    if (fileName.startsWith('_') || post.frontmatter.isCategory) return false;
    if (currentPath === post.url || currentPath === post.url + '/') return false;
    
    const postCategoryPath = getCategoryPathFromUrl(post.url);
    return postCategoryPath && currentCategoryPath && postCategoryPath === currentCategoryPath;
})
.sort((a, b) => new Date(b.frontmatter.date || 0).valueOf() - new Date(a.frontmatter.date || 0).valueOf());
---
<BlogLayout title={`${frontmatter.title} | Studio.lib`} description={frontmatter.description} headings={headings}>
    <article class="sl-markdown-content">
        <header class="post-header">
            <h1 id="_top">{frontmatter.title}</h1>
            <div class="post-meta">
                <span>{frontmatter.date}</span>
                {frontmatter.tags && frontmatter.tags.map((tag: string) => (
                    <span class="tag">#{tag}</span>
                ))}
            </div>
        </header>
        
        <div class="post-content">
            <slot />
        </div>

        <div class="comments-section">
            <h2 id="comments">Comments</h2>
            <GiscusComments />
        </div>

        {categoryPosts.length > 0 && (
            <div class="category-posts-section">
                <h2 id="more-posts">More Posts</h2>
                <PostList posts={categoryPosts} />
            </div>
        )}
    </article>
</BlogLayout>

<style>
    /* Layout specific styles for blog posts */
    .post-header { margin-bottom: 3rem; }
    .post-meta {
        display: flex;
        gap: 0.5rem 1rem;
        flex-wrap: wrap;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--muted-foreground);
        margin-top: 1rem;
    }
    .category-posts-section, .comments-section {
        margin-top: 0.5rem;
        padding-top: 0.5rem;
    }
    #more-posts {
        margin-bottom: 0rem;
    }
</style>