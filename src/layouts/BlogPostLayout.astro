---
import BlogLayout from './BlogLayout.astro';
import PostList from '../components/PostList.astro';
import GiscusComments from '../components/GiscusComments.astro';

const { frontmatter, headings } = Astro.props;

// 같은 카테고리의 포스트들을 불러오기
const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true })) as any[];
const currentPath = Astro.url.pathname;

const categoryPosts = allPosts.filter(post => {
    if (post.file.endsWith('_blog-index.md') || post.frontmatter.isCategory) return false;
    if (currentPath === post.url || currentPath === post.url + '/') return false;
    return post.frontmatter.category && frontmatter.category && 
           post.frontmatter.category === frontmatter.category;
})
.sort((a, b) => new Date(b.frontmatter.date || 0).valueOf() - new Date(a.frontmatter.date || 0).valueOf());
---
<BlogLayout title={`${frontmatter.title} | Studio.lib`} description={frontmatter.description} headings={headings}>
    <article class="sl-markdown-content">
        <header class="post-header">
            <h1 id="_top">{frontmatter.title}</h1>
            <div class="post-meta">
                <span>{frontmatter.date}</span>
                {frontmatter.tags && frontmatter.tags.map((tag: string) => (
                    <span class="tag">#{tag}</span>
                ))}
            </div>
            {frontmatter.heroImage && (
                <img src={frontmatter.heroImage} alt={frontmatter.title} class="hero-image" />
            )}
        </header>
        
        <div class="post-content">
            <slot />
        </div>

        <div class="comments-section">
            <h2 id="comments">Comments</h2>
            <GiscusComments />
        </div>

        {categoryPosts.length > 0 && (
            <div class="category-posts-section">
                <h2 id="more-posts">More Posts</h2>
                <PostList posts={categoryPosts} />
            </div>
        )}
    </article>
</BlogLayout>

<style is:global>
    /* Content Typography Optimization */
    .sl-markdown-content {
        font-family: 'Pretendard', var(--font-sans);
        letter-spacing: 0;
        word-break: keep-all;
        /* 본문 폰트 크기 축소 (15px ~ 16px) */
        font-size: clamp(0.9375rem, 0.915rem + 0.1vw, 1rem);
    }

    .sl-markdown-content strong,
    .sl-markdown-content b {
        font-weight: 550;
    }

    .sl-markdown-content :is(h1, h2, h3, h4, h5, h6) {
        font-weight: 500; /* 다시 500으로 낮추어 깔끔하게 변경 */
        letter-spacing: var(--tracking-tight);
        color: var(--foreground);
    }

    .sl-markdown-content h1 {
        font-size: 1.75rem;
        font-weight: 600; /* 인덱스 제목과 동일하게 600으로 통일 */
        line-height: 1.3;
        margin-bottom: 1rem;
    }

    .sl-markdown-content h2 {
        font-size: 1.25rem; /* 예전 크기로 고정 */
        font-weight: 500;
        line-height: 1.4;
        margin-top: 3rem;
        padding-top: 1rem;
        padding-bottom: 0.5rem;
    }

    .sl-markdown-content h3 {
        font-size: 1.125rem;
        margin-top: 2.25rem;
    }

    .sl-markdown-content p {
        line-height: 1.82;
        margin-bottom: 1.5rem;
        color: var(--foreground);
    }

    @media (max-width: 600px) {
        .sl-markdown-content p {
            line-height: 1.77;
            margin-bottom: 1.25rem;
        }
        .sl-markdown-content h2 { margin-top: 2.5rem; }
    }

    .sl-markdown-content a:not([class]) {
        text-decoration: underline;
        text-underline-offset: 0.25rem;
        text-decoration-color: var(--signature-color);
        color: var(--signature-color);
        font-weight: 500;
        transition: color 0.15s, text-decoration-color 0.15s;
    }

    .sl-markdown-content blockquote {
        border-left: 4px solid var(--signature-color);
        padding: 0.5rem 1rem;
        color: var(--muted-foreground);
        background: var(--muted);
        margin: 1.5rem 0;
        border-radius: 0 var(--radius) var(--radius) 0;
        font-style: italic;
    }

    .sl-markdown-content ul, .sl-markdown-content ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }

    .sl-markdown-content li {
        margin-bottom: 0.5rem;
        line-height: 1.75;
    }

    .sl-markdown-content pre {
        background-color: #0a0a0a !important;
        color: #fafafa;
        padding: 1.5rem;
        border-radius: var(--radius);
        margin: 1.5rem 0;
        border: 1px solid var(--border-color);
        font-size: 0.875rem;
        line-height: 1.6;
    }

    .sl-markdown-content img {
        max-width: 100%;
        border-radius: var(--radius);
        margin: 1.5rem 0;
        border: 1px solid var(--border-color);
    }

    /* Layout Styles */
    .post-header { margin-bottom: 3rem; }
    .post-meta {
        display: flex;
        gap: 0.5rem 1rem;
        flex-wrap: wrap;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--muted-foreground);
        margin-top: 1rem;
    }
    .hero-image {
        width: 100%;
        height: auto;
        display: block;
        max-height: 400px;
        object-fit: cover;
        margin-top: 2rem;
        border-radius: var(--radius);
    }
    .category-posts-section, .comments-section {
        margin-top: 0.5rem;
        padding-top: 0.5rem;
    }
</style>