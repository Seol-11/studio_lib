---
import { categories } from '../pages/_categories';

// src/components/BlogSidebar.astro
---

<aside class="lucode-sidebar">
    <nav class="lucode-sidebar-nav">
        <!-- Personal Space: Lo-fi / Anime Vibes -->
        <div class="personal-space">
            <div class="group-title">PERSONAL_SPACE</div>
            
            <!-- Anime Profile Box -->
            <div class="nature-box">
                <div class="nature-image" style="background-image: url('https://i.pinimg.com/1200x/98/90/4e/98904e5111b35f7cecaeefe80ba51837.jpg');"></div>
                <div class="nature-overlay">
                    <span class="location-tag">NEO_TOKYO // CORE</span>
                    <span class="status-tag">STATUS: ONLINE</span>
                </div>
            </div>

            <!-- Interactive Compact Music Widget -->
            <div class="playlist-widget interactive-compact" id="music-widget">
                <div class="now-playing-header">
                    <div class="music-bars">
                        <div class="bar"></div><div class="bar"></div><div class="bar"></div>
                    </div>
                    <div class="track-display">
                        <div class="track-scroll-wrapper">
                            <div class="track-content">
                                <span class="track-title">검은산</span>
                                <span class="track-separator">-</span>
                                <span class="track-artist">wave to earth</span>
                            </div>
                            <div class="track-content" aria-hidden="true">
                                <span class="track-title">검은산</span>
                                <span class="track-separator">-</span>
                                <span class="track-artist">wave to earth</span>
                            </div>
                        </div>
                    </div>
                    <button class="anim-toggle" id="music-anim-toggle" title="Toggle Animation">
                        <div class="toggle-dot"></div>
                    </button>
                </div>
                <!-- Playback Bar -->
                <div class="playback-bar">
                    <div class="playback-progress"></div>
                </div>
            </div>
        </div>

        <div class="group-title">CATEGORIES</div>
        <!-- Categories -->
        {categories.map(category => {
            if (category.type === 'folder' || category.type === 'category') {
                return (
                    <details class="category-folder" data-folder-id={category.id || category.title}>
                        <summary class="sidebar-group-title">{category.title}</summary>
                        <div class="folder-content">
                            <ul class="sidebar-list">
                                {category.items && category.items.map(item => (
                                    <li>
                                        <a href={item.path} class="sidebar-link">{item.title}</a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </details>
                );
            } else if (category.type === 'link') {
                return (
                    <div class="sidebar-group">
                        <ul class="sidebar-list no-indent">
                            <li>
                                <a href={category.path} class="sidebar-link top-level">{category.title}</a>
                            </li>
                        </ul>
                    </div>
                );
            }
        })}
    </nav>
</aside>

<script>
    const initSidebar = () => {
        const folders = document.querySelectorAll('.category-folder');
        folders.forEach(folder => {
            const id = folder.getAttribute('data-folder-id');
            if (!id) return;

            const state = localStorage.getItem(`folder-state-${id}`);
            if (state === 'closed') {
                folder.removeAttribute('open');
            } else {
                folder.setAttribute('open', ''); // 기본값은 열림
            }

            const summary = folder.querySelector('summary');
            const newSummary = summary.cloneNode(true);
            summary.parentNode.replaceChild(newSummary, summary);

            newSummary.addEventListener('click', () => {
                setTimeout(() => {
                    localStorage.setItem(`folder-state-${id}`, folder.hasAttribute('open') ? 'open' : 'closed');
                }, 50);
            });
        });

        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        const links = document.querySelectorAll('.sidebar-link');
        
        links.forEach(link => {
            const href = link.getAttribute('href').replace(/\/$/, '') || '/';
            link.classList.remove('active');
            if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
                link.classList.add('active');
            }
        });

        // Music Widget Animation Toggle
        const musicWidget = document.getElementById('music-widget');
        const animToggle = document.getElementById('music-anim-toggle');
        
        if (musicWidget && animToggle) {
            const isPaused = localStorage.getItem('music-anim-paused') === 'true';
            if (isPaused) musicWidget.classList.add('paused');

            const newToggle = animToggle.cloneNode(true);
            animToggle.parentNode.replaceChild(newToggle, animToggle);

            newToggle.addEventListener('click', () => {
                const nowPaused = musicWidget.classList.toggle('paused');
                localStorage.setItem('music-anim-paused', nowPaused);
            });
        }
    };

    document.addEventListener('astro:page-load', initSidebar);
</script>

<style>
    .lucode-sidebar {
        width: 18rem;
        flex-shrink: 0;
        position: sticky;
        top: 3.5rem;
        height: calc(100vh - 3.5rem);
        border-right: 1px solid transparent;
        border-image: linear-gradient(to bottom, transparent, var(--border-color) 20%, var(--border-color) 80%, transparent) 1;
        background-color: var(--bg-color);
        
        /* 다시 독립 스크롤을 부모로 복구, 좌우 여백만 줌 */
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 0 2rem;
        
        /* 스크롤바 숨기기 */
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .lucode-sidebar::-webkit-scrollbar {
        display: none;
    }

    .lucode-sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        
        /* 기존 상하 여백을 자식 요소에 주어, 이 여백도 함께 스크롤 되도록 만듦 */
        padding-top: 3rem;
        padding-bottom: 5rem;
    }

    /* Personal Space Styling */
    .personal-space {
        margin-bottom: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .nature-box {
        position: relative;
        width: 100%;
        height: 110px;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--border-color);
    }
    .nature-image {
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        filter: saturate(0.8) contrast(0.9);
        transition: transform 0.6s ease;
    }
    .nature-box:hover .nature-image {
        transform: scale(1.1);
    }
    .nature-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7), transparent 60%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 0.75rem;
        color: white;
        font-family: var(--font-mono);
        pointer-events: none;
    }
    .location-tag { font-size: 0.55rem; opacity: 0.7; letter-spacing: 0.5px; }
    .status-tag { font-size: 0.65rem; font-weight: 700; color: var(--signature-color); margin-top: 2px; }

    /* Interactive Compact Music Widget */
    .playlist-widget {
        background: var(--muted);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 0.6rem 0.85rem;
        font-family: 'Pretendard', var(--font-mono);
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .now-playing-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .music-bars {
        display: flex;
        align-items: flex-end;
        gap: 2px;
        height: 10px;
        flex-shrink: 0;
    }
    .bar {
        width: 2px;
        background: var(--signature-color);
        animation: music-flow 0.8s ease-in-out infinite alternate;
    }
    .bar:nth-child(2) { animation-delay: 0.2s; }
    .bar:nth-child(3) { animation-delay: 0.4s; }

    @keyframes music-flow {
        from { height: 2px; }
        to { height: 10px; }
    }

    .track-display {
        flex: 1;
        overflow: hidden;
    }

    .track-scroll-wrapper {
        display: flex;
        width: max-content;
        font-size: 0.7rem;
        color: var(--foreground);
        animation: scroll-text 15s linear infinite;
    }

    .track-content {
        display: flex;
        align-items: center;
        padding-right: 2.5rem;
    }

    /* Animation Control */
    .playlist-widget.paused .playback-progress {
        animation-play-state: paused !important;
    }

    .playlist-widget.paused .bar,
    .playlist-widget.paused .track-scroll-wrapper {
        animation: none !important;
    }

    .playlist-widget.paused .bar {
        height: 2px !important;
    }

    .anim-toggle {
        background: none;
        border: none;
        padding: 5px;
        cursor: pointer;
        opacity: 0.3;
        transition: opacity 0.2s, transform 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 4px;
    }
    .anim-toggle:hover { opacity: 1; transform: scale(1.2); }
    .toggle-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--signature-color);
        box-shadow: 0 0 5px var(--signature-color);
    }
    .playlist-widget.paused .toggle-dot {
        background: var(--muted-foreground);
        box-shadow: none;
    }

    @keyframes scroll-text {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    .track-artist { font-weight: 500; opacity: 0.7; }
    .track-separator { opacity: 0.5; margin: 0 4px; }
    .track-title { font-weight: 800; opacity: 0.9; }

    /* Playback Bar */
    .playback-bar {
        height: 2px;
        background: var(--border-color);
        border-radius: 1px;
        margin-top: 0.7rem;
        width: 100%;
        overflow: hidden;
    }
    .playback-progress {
        height: 100%;
        background: var(--signature-color);
        width: 35%;
        border-radius: 1px;
        animation: progress-flow 180s linear infinite;
    }
    @keyframes progress-flow {
        0% { width: 0%; }
        100% { width: 100%; }
    }

    .group-title {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--foreground);
        opacity: 0.6;
        margin-bottom: 0.5rem;
        letter-spacing: 1px;
        padding-left: 0.5rem;
    }

    /* Accordion Styles */
    .category-folder {
        margin-bottom: 0.5rem;
    }

    .sidebar-group-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--foreground);
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        user-select: none;
        list-style: none;
        display: flex;
        align-items: center;
        transition: color 0.15s;
    }
    
    .sidebar-group-title:hover { color: var(--signature-color); }
    .sidebar-group-title::-webkit-details-marker { display: none; }
    .sidebar-group-title::before {
        content: '>';
        font-family: var(--font-mono);
        font-size: 0.7rem;
        display: inline-block;
        margin-right: 0.5rem;
        transition: transform 0.2s ease-in-out;
        transform-origin: center;
        color: var(--muted-foreground);
    }
    details[open] .sidebar-group-title::before { transform: rotate(90deg); }

    .folder-content { margin-top: 0.25rem; }
    .sidebar-list {
        list-style: none;
        padding: 0;
        margin: 0;
        padding-left: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }
    .sidebar-list.no-indent { padding-left: 0; }
    .sidebar-link {
        display: block;
        padding: 0.375rem 0.5rem;
        font-size: 0.8rem;
        text-decoration: none;
        color: var(--muted-foreground);
        border-radius: 0.375rem;
        transition: color 0.15s, background-color 0.15s;
        line-height: 1.25rem;
    }
    .sidebar-link:hover {
        color: var(--foreground);
        background-color: var(--muted);
    }
    .sidebar-link.active {
        color: var(--signature-color);
        background-color: var(--muted);
        font-weight: 600;
    }

    @media (max-width: 1024px) {
        .lucode-sidebar {
            display: none; 
        }
        .lucode-sidebar.mobile-open {
            display: block;
            position: fixed;
            top: 3.5rem;
            left: 0;
            width: 100%;
            height: calc(100vh - 3.5rem);
            background: var(--bg-color);
            z-index: 999;
            padding: 0 1.5rem;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }
        .lucode-sidebar.mobile-open::-webkit-scrollbar {
            display: none;
        }
        .lucode-sidebar.mobile-open .lucode-sidebar-nav {
            padding-top: 2rem;
            padding-bottom: 5rem;
        }
    }
</style>