---
import { categories } from '../pages/_categories';

// src/components/BlogSidebar.astro
---

<aside class="lucode-sidebar">
    <nav class="lucode-sidebar-nav">
        <div class="group-title">CATEGORIES</div>
        <!-- Categories -->
        {categories.map(category => {
            if (category.type === 'folder' || category.type === 'category') {
                return (
                    <details class="category-folder" data-folder-id={category.id || category.title}>
                        <summary class="sidebar-group-title">{category.title}</summary>
                        <div class="folder-content">
                            <ul class="sidebar-list">
                                {category.items.map(item => (
                                    <li>
                                        <a href={item.path} class="sidebar-link">{item.title}</a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </details>
                );
            } else if (category.type === 'link') {
                return (
                    <div class="sidebar-group">
                        <ul class="sidebar-list no-indent">
                            <li>
                                <a href={category.path} class="sidebar-link top-level">{category.title}</a>
                            </li>
                        </ul>
                    </div>
                );
            }
        })}
    </nav>
</aside>

<script is:inline>
    // FOUC 방지 및 폴더 상태 유지
    (function() {
        const folders = document.querySelectorAll('.category-folder');
        folders.forEach(folder => {
            const id = folder.getAttribute('data-folder-id');
            if (!id) return;

            const state = localStorage.getItem(`folder-state-${id}`);
            if (state === 'closed') {
                folder.removeAttribute('open');
            } else {
                folder.setAttribute('open', ''); // 기본값은 열림
            }

            folder.addEventListener('toggle', () => {
                localStorage.setItem(`folder-state-${id}`, folder.hasAttribute('open') ? 'open' : 'closed');
            });
        });
    })();

    document.addEventListener('DOMContentLoaded', () => {
        const currentPath = window.location.pathname.replace(/\/$/, '');
        const links = document.querySelectorAll('.sidebar-link');
        
        links.forEach(link => {
            const href = link.getAttribute('href').replace(/\/$/, '');
            if (href === currentPath || (href !== '' && currentPath.startsWith(href))) {
                link.classList.add('active');
            }
        });
    });
</script>

<style>
    .lucode-sidebar {
        width: 18rem;
        flex-shrink: 0;
        position: sticky;
        top: 3.5rem;
        height: calc(100vh - 3.5rem);
        overflow-y: auto;
        padding: 3rem 2rem;
        border-right: 1px solid transparent;
        /* starlight-like fading gradient border on the right */
        border-image: linear-gradient(to bottom, transparent, var(--border-color) 20%, var(--border-color) 80%, transparent) 1;
        background-color: var(--bg-color);
    }

    .lucode-sidebar::-webkit-scrollbar {
        width: 6px;
    }
    .lucode-sidebar::-webkit-scrollbar-thumb {
        background-color: var(--border-color);
        border-radius: 4px;
    }

    .lucode-sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .group-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--foreground);
        opacity: 0.6;
        margin-bottom: 0.5rem;
        letter-spacing: 1px;
        padding-left: 0.5rem; /* Aligns with category text */
    }

    /* Accordion Styles */
    .category-folder {
        margin-bottom: 0.5rem;
    }

    .sidebar-group-title {
        font-size: 0.8rem; /* Decreased font size */
        font-weight: 600;
        color: var(--foreground);
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        user-select: none;
        list-style: none;
        display: flex;
        align-items: center;
        transition: color 0.15s;
    }
    
    .sidebar-group-title:hover {
        color: var(--signature-color);
    }

    .sidebar-group-title::-webkit-details-marker {
        display: none;
    }

    .sidebar-group-title::before {
        content: '>';
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        display: inline-block;
        margin-right: 0.5rem;
        transition: transform 0.2s ease-in-out;
        transform-origin: center;
        color: var(--muted-foreground);
    }

    details[open] .sidebar-group-title::before {
        transform: rotate(90deg);
    }

    .folder-content {
        margin-top: 0.25rem;
    }

    .sidebar-list {
        list-style: none;
        padding: 0;
        margin: 0;
        padding-left: 1rem; /* Indentation for items */
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }

    .sidebar-list.no-indent {
        padding-left: 0;
    }

    .sidebar-link {
        display: block;
        padding: 0.375rem 0.5rem;
        font-size: 0.8rem; /* Decreased font size */
        text-decoration: none;
        color: var(--muted-foreground);
        border-radius: 0.375rem;
        transition: color 0.15s, background-color 0.15s;
        line-height: 1.25rem;
    }

    .sidebar-link:hover {
        color: var(--foreground);
        background-color: var(--muted);
    }

    .sidebar-link.active {
        color: var(--signature-color);
        background-color: var(--muted);
        font-weight: 600;
    }

    .top-level {
        font-weight: 500;
    }

    @media (max-width: 1024px) {
        .lucode-sidebar {
            display: none; 
        }
        .lucode-sidebar.mobile-open {
            display: block;
            position: fixed;
            top: 3.5rem;
            left: 0;
            width: 100%;
            height: calc(100vh - 3.5rem);
            background: var(--bg-color);
            z-index: 999;
            padding: 2rem 1.5rem;
            border-image: none;
            border-right: none;
        }
    }
</style>