---
// src/components/Stickers.astro

// 1. 엄격한 타입 인터페이스 (rotate 타입 제한, loading 옵션 추가)
interface Props {
    type: "QC_PASSED" | "HIGH_VOLTAGE" | "LOGIC_GATE" | "TAPE_OUT" | "CHIPLET_NODE";
    top?: string;
    bottom?: string;
    left?: string;
    right?: string;
    rotate?: number;
    width?: number;
    href?: string;   
    hover?: boolean; 
    loading?: "eager" | "lazy"; // [추가] LCP 최적화를 위한 로딩 전략 분기
}

const { 
    type = "QC_PASSED", 
    top, 
    bottom, 
    left, 
    right, 
    rotate = 0,
    width = 100,
    href,
    hover = true,
    loading = "eager" // 화면 상단 요소가 많으므로 기본값은 즉시 로딩(eager)
} = Astro.props;

// 2. 에셋 베이스 경로 분리 (환경 이식성 확보)
const BASE_PATH = "/stickers";

const stickerData = {
    QC_PASSED: { src: `${BASE_PATH}/kiki.jpg`, alt: "QC PASSED Stamp" },
    HIGH_VOLTAGE: { src: `${BASE_PATH}/high-voltage.webp`, alt: "HIGH VOLTAGE Danger Sign" },
    LOGIC_GATE: { src: `${BASE_PATH}/logic-gate.webp`, alt: "AND Gate Symbol" },
    TAPE_OUT: { src: `${BASE_PATH}/tape-out.webp`, alt: "Tape Out Success" },
    CHIPLET_NODE: { src: `${BASE_PATH}/chiplet.webp`, alt: "Chiplet Interconnect" }
};

const sticker = stickerData[type] || stickerData.QC_PASSED;

// 3. 인라인 스타일 및 CSS 변수 동적 할당
// --original-rotate라는 CSS 변수에 값을 캐싱하여 호버 시 각도가 깨지지 않도록 설계
const styleString = [
    top ? `top: ${top}` : '',
    bottom ? `bottom: ${bottom}` : '',
    left ? `left: ${left}` : '',
    right ? `right: ${right}` : '',
    `width: ${width}px`,
    `transform: rotate(${rotate}deg)`,
    `--original-rotate: ${rotate}deg` // CSS로 상태 전달
].filter(Boolean).join('; ');

const isExternal = href?.startsWith('http');
---

{href ? (
    <a 
        href={href}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}
        aria-label={`Link to ${href} - ${sticker.alt}`}
        class:list={["sticker-wrapper", { interactive: hover }, "has-link"]}
        style={styleString}
    >
        <img src={sticker.src} alt={sticker.alt} loading={loading} />
    </a>
) : (
    <div 
        class:list={["sticker-wrapper", { interactive: hover }]}
        style={styleString}
    >
        <img src={sticker.src} alt={sticker.alt} loading={loading} />
    </div>
)}

<style>
    .sticker-wrapper {
        position: absolute;
        display: block;
        height: auto;
        opacity: 0.85; 
        z-index: 20; 
        pointer-events: auto;
        text-decoration: none; 
        /* 렌더링 성능 최적화: GPU 가속 힌트 제공 */
        will-change: transform, opacity;
    }

    .sticker-wrapper img {
        width: 100%;
        height: auto;
        display: block;
        /* 서브픽셀 렌더링 시 이미지 깨짐 방지 */
        image-rendering: optimizeQuality;
    }
    
    .sticker-wrapper.interactive {
        transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    
    .sticker-wrapper.interactive:hover {
        opacity: 1;
        /* [핵심 수정] 0deg 강제 초기화를 없애고 원본 회전각 유지 */
        transform: scale(1.15) rotate(var(--original-rotate)) !important; 
        /* transform: scale(1.15) rotate(0) !important;  */
        z-index: 60;
    }

    .sticker-wrapper.has-link {
        cursor: pointer;
    }

    @media (max-width: 600px) {
        .sticker-wrapper {
            display: none !important;
        }
    }
</style>