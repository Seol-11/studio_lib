---
// src/components/EngineeringSticker.astro
const { type = "QC_PASSED", top, left, rotate } = Astro.props;

// 스티커 종류에 따른 데이터 매핑 (이미지 경로, 대체 텍스트)
const stickerData = {
    QC_PASSED: { src: "/stickers/kiki.jpg", alt: "QC PASSED Stamp" },
    HIGH_VOLTAGE: { src: "/stickers/high-voltage.webp", alt: "HIGH VOLTAGE Danger Sign" },
    LOGIC_GATE: { src: "/stickers/logic-gate.webp", alt: "AND Gate Symbol" },
    // 추가적인 스티커 데이터 노드 삽입 가능
};

const sticker = stickerData[type] || stickerData.QC_PASSED;
---

<img 
    src={sticker.src} 
    alt={sticker.alt} 
    class="sticker" 
    style={{ top, left, transform: `rotate(${rotate}deg)` }} 
/>

<style>
    .sticker {
        position: absolute;
        width: 100px; /* 스티커 크기 규격화 */
        height: auto;
        opacity: 0.7; /* 배경과 자연스럽게 어우러지도록 투명도 조절 */
        transition: opacity 0.2s;
    }
    
    .sticker:hover {
        opacity: 1; /* 마우스 오버 시 시각적 피드백 제공 */
    }
</style>