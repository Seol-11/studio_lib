---
export interface Props {
    posts: any[];
    subCategories?: string[];
}

const { posts, subCategories = [] } = Astro.props;

// 각 서브 카테고리별 글 개수 계산
const subCategoryCounts = subCategories.reduce((acc, cat) => {
    acc[cat] = posts.filter(p => p.subCategory === cat).length;
    return acc;
}, {} as Record<string, number>);

const totalCount = posts.length;
---

<div class="lucode-post-list-wrapper">
    {subCategories.length > 0 && (
        <div class="subcategory-filter">
            <button class="subcat-btn active" data-subcat="all">
                All Posts <span class="count">({totalCount})</span>
            </button>
            {subCategories.map(cat => (
                <button class="subcat-btn" data-subcat={cat}>
                    {cat} <span class="count">({subCategoryCounts[cat] || 0})</span>
                </button>
            ))}
        </div>
    )}

    <div class="lucode-post-list" id="post-list-container">
        {posts.length === 0 ? (
            <p class="empty-state">아직 작성된 글이 없습니다.</p>
        ) : (
            posts.map(post => (
                <article 
                    class="post-item" 
                    data-title={post.frontmatter.title} 
                    data-tags={(post.frontmatter.tags || []).join(',')}
                    data-subcat={post.subCategory || ''}
                >
                    <div class="post-content-wrapper">
                        <div class="post-date">{post.frontmatter.date || 'No Date'}</div>
                        <a href={post.url} class="post-link">
                            <h2 class="post-title">{post.frontmatter.title}</h2>
                        </a>
                        {post.frontmatter.description && <p class="post-excerpt">{post.frontmatter.description}</p>}
                        {post.frontmatter.tags && (
                            <div class="post-tags">
                                {post.frontmatter.tags.map((tag: string) => (
                                    <button class="tag tag-btn" data-tag={tag}>#{tag}</button>
                                ))}
                            </div>
                        )}
                    </div>
                    {post.frontmatter.heroImage && post.frontmatter.heroImage !== 'none' && post.frontmatter.heroImage !== 'false' && post.frontmatter.heroImage !== 'null' && (
                        <a href={post.url} class="post-thumb-wrapper">
                            <img src={post.frontmatter.heroImage} alt={post.frontmatter.title} class="post-thumb" />
                        </a>
                    )}
                </article>
            ))
        )}
        <div id="no-results" class="empty-state" style="display: none;">검색 결과가 없습니다.</div>
    </div>

    {posts.length > 0 && (
        <div class="post-controls">
            <input type="text" id="post-search" placeholder="글 제목, 태그 검색..." autocomplete="off" />
        </div>
    )}

    <div class="pagination" id="pagination-container"></div>
</div>

<script>
    import Fuse from 'fuse.js';

    const initPostList = () => {
        const ITEMS_PER_PAGE = 5; 
        const searchInput = document.getElementById('post-search');
        const postItems = Array.from(document.querySelectorAll('.post-item'));
        const paginationContainer = document.getElementById('pagination-container');
        const noResults = document.getElementById('no-results');

        if (!postItems.length) return; 

        const searchData = postItems.map(item => ({
            element: item,
            title: (item as HTMLElement).dataset.title || '',
            tags: (item as HTMLElement).dataset.tags || '',
            subcat: (item as HTMLElement).dataset.subcat || ''
        }));

        const fuse = new Fuse(searchData, {
            keys: [
                { name: 'title', weight: 0.7 },
                { name: 'tags', weight: 0.3 }
            ],
            threshold: 0.3,
            ignoreLocation: true
        });

        let currentPage = 1;
        let currentSubcat = 'all';
        let filteredItems = [...postItems];

        function render() {
            const currentSearchInput = document.getElementById('post-search') as HTMLInputElement;
            const query = currentSearchInput ? currentSearchInput.value : '';

            // 1. 텍스트 검색 및 서브 카테고리 필터링
            let results = [...searchData];

            if (currentSubcat !== 'all') {
                results = results.filter(item => item.subcat === currentSubcat);
            }

            if (query.trim() !== '') {
                const fuseFiltered = new Fuse(results, {
                    keys: [
                        { name: 'title', weight: 0.7 },
                        { name: 'tags', weight: 0.3 }
                    ],
                    threshold: 0.3,
                    ignoreLocation: true
                });
                results = fuseFiltered.search(query).map(r => r.item);
            }

            filteredItems = results.map(r => r.element);

            // 2. 페이지네이션 계산
            const totalPages = Math.ceil(filteredItems.length / ITEMS_PER_PAGE);
            if (currentPage > totalPages) currentPage = totalPages || 1;

            const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
            const endIndex = startIndex + ITEMS_PER_PAGE;

            // 3. UI 업데이트
            postItems.forEach(item => {
                (item as HTMLElement).style.display = 'none';
            });
            
            if (filteredItems.length === 0) {
                if (noResults) noResults.style.display = 'block';
                if (paginationContainer) paginationContainer.innerHTML = '';
            } else {
                if (noResults) noResults.style.display = 'none';
                filteredItems.slice(startIndex, endIndex).forEach(item => {
                    (item as HTMLElement).style.display = 'flex'; 
                });
                renderPagination(totalPages);
            }
        }

        function renderPagination(totalPages: number) {
            if (!paginationContainer) return;
            if (totalPages <= 1) {
                paginationContainer.innerHTML = '';
                return;
            }

            let html = '';
            html += `<button class="page-btn nav-btn" data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''}>&lt;</button>`;
            
            for (let i = 1; i <= totalPages; i++) {
                html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
            }

            html += `<button class="page-btn nav-btn" data-page="${currentPage + 1}" ${currentPage === totalPages ? 'disabled' : ''}>&gt;</button>`;
            
            paginationContainer.innerHTML = html;

            paginationContainer.querySelectorAll('.page-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (btn.hasAttribute('disabled')) return;
                    currentPage = parseInt((btn as HTMLElement).dataset.page || '1');
                    render();
                    
                    const listWrapper = document.querySelector('.lucode-post-list-wrapper');
                    if (listWrapper) {
                        const top = listWrapper.getBoundingClientRect().top + window.scrollY - 100;
                        window.scrollTo({ top, behavior: 'smooth' });
                    }
                });
            });
        }

        if (searchInput) {
            const params = new URLSearchParams(window.location.search);
            const q = params.get('q');
            if (q && !(searchInput as HTMLInputElement).value) {
                (searchInput as HTMLInputElement).value = q;
            }
            
            if (!searchInput.hasAttribute('data-listener-attached')) {
                searchInput.setAttribute('data-listener-attached', 'true');
                searchInput.addEventListener('input', () => { 
                    currentPage = 1; 
                    render(); 
                });
            }
        }

        const subcatBtns = document.querySelectorAll('.subcat-btn');
        subcatBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const target = e.currentTarget as HTMLElement;
                const cat = target.dataset.subcat;
                if (!cat) return;

                // Update active state
                subcatBtns.forEach(b => b.classList.remove('active'));
                target.classList.add('active');

                currentSubcat = cat;
                currentPage = 1;
                render();
            });
        });

        document.querySelectorAll('.tag-btn').forEach(btn => {
            if (!btn.hasAttribute('data-listener-attached')) {
                btn.setAttribute('data-listener-attached', 'true');
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const tag = btn.getAttribute('data-tag');
                    if (!tag) return;
                    
                    if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
                        const activeSearchInput = document.getElementById('post-search') as HTMLInputElement;
                        if (activeSearchInput) {
                            activeSearchInput.value = tag;
                            activeSearchInput.dispatchEvent(new Event('input'));
                            window.history.pushState({}, '', `/?q=${tag}`);
                            
                            const listWrapper = document.querySelector('.lucode-post-list-wrapper');
                            if (listWrapper) {
                                const top = listWrapper.getBoundingClientRect().top + window.scrollY - 100;
                                window.scrollTo({ top, behavior: 'smooth' });
                            }
                        }
                    } else {
                        window.location.href = `/?q=${tag}`;
                    }
                });
            }
        });

        render();
    };

    document.addEventListener('astro:page-load', initPostList);
</script>

<style>
    .subcategory-filter {
        display: flex;
        gap: 0.35rem; /* Slightly tighter gap since prefix is gone */
        flex-wrap: wrap;
        width: 100%;
        margin-top: 2rem;
        margin-bottom: -1rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
        border-bottom: none;
    }

    .subcat-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--foreground);
        padding: 0.3rem 0.6rem;
        border-radius: var(--radius);
        font-size: 0.9rem;
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        transition: all var(--transition-fast);
        opacity: 0.85; /* Keep it very clear but slightly less than active */
    }

    .subcat-btn:hover {
        background-color: var(--muted);
        opacity: 1;
    }

    .subcat-btn.active {
        color: var(--foreground);
        background-color: var(--muted);
        opacity: 1;
        font-weight: 700;
    }

    .subcat-btn .count {
        font-size: 0.8125rem; /* Increased from 0.75rem */
        opacity: 0.45;
        margin-left: 0.2rem;
        font-weight: 400;
    }

    .subcat-btn.active .count {
        opacity: 0.7;
    }

    .lucode-post-list-wrapper {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .post-controls {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .post-controls input {
        padding: 0.4rem 0.8rem;
        border: 1px solid var(--border-color);
        background: transparent;
        border-radius: var(--radius);
        color: var(--foreground);
        font-family: inherit;
        font-size: 0.8rem;
        outline: none;
        transition: border-color 0.15s;
        width: 100%;
        max-width: 400px;
    }
    .post-controls input:focus {
        border-color: var(--foreground);
    }

    .lucode-post-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .post-item {
        position: relative;
        display: none; 
        flex-direction: row;
        align-items: center; 
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.5rem 0; 
        margin: 0;
        border-bottom: 1px solid var(--border-color);
    }

    .post-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .post-content-wrapper {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    
    .empty-state {
        color: var(--muted-foreground);
        font-size: 0.875rem;
        padding: 2rem 0;
    }
    
    .post-date {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--muted-foreground);
    }
    
    .post-thumb-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 160px;
        height: 100px;
        margin: 0;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid var(--border-color);
        transition: border-color 0.15s;
    }
    .post-thumb-wrapper:hover {
        border-color: var(--signature-color);
    }
    
    .post-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        margin: 0;
    }
    
    .post-link {
        text-decoration: none;
        color: var(--foreground);
        display: block; 
        width: 100%; 
    }
    .post-title {
        font-size: var(--font-size-h2);
        font-weight: var(--weight-semibold);
        margin: 0;
        line-height: 1.3;
        letter-spacing: var(--tracking-tight);
        transition: color var(--transition-fast);
    }
    .post-link:hover .post-title {
        color: var(--signature-color);
    }
    
    .post-excerpt {
        color: var(--muted-foreground);
        font-size: 0.9375rem;
        line-height: 1.5;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .post-tags {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.25rem;
        flex-wrap: wrap;
    }
    .tag {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--signature-color);
        padding: 0.15rem 0.5rem;
        border-radius: 0.25rem;
        background-color: transparent;
        border: 1px solid var(--signature-color);
        cursor: pointer;
        transition: background-color 0.15s, color 0.15s;
    }
    .tag:hover {
        background-color: var(--signature-color);
        color: var(--bg-color);
    }

    @media (max-width: 600px) {
        .post-item {
            gap: 1rem;
        }
        .post-thumb-wrapper {
            width: 100px;
            height: 80px;
        }
        .post-title {
            font-size: 1.1rem;
            line-height: 1.35;
        }
        .post-excerpt {
            font-size: 0.85rem;
            -webkit-line-clamp: 2;
        }
        .tag {
            font-size: 0.7rem;
            padding: 0.1rem 0.4rem;
        }
    }
</style>