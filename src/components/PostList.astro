---
export interface Props {
    posts: any[];
}

const { posts } = Astro.props;
---

<div class="lucode-post-list-wrapper">
    <div class="lucode-post-list" id="post-list-container">
        {posts.length === 0 ? (
            <p class="empty-state">아직 작성된 글이 없습니다.</p>
        ) : (
            posts.map(post => (
                <article 
                    class="post-item" 
                    data-title={post.frontmatter.title} 
                    data-tags={(post.frontmatter.tags || []).join(',')}
                >
                    <div class="post-content-wrapper">
                        <div class="post-date">{post.frontmatter.date || 'No Date'}</div>
                        <a href={post.url} class="post-link">
                            <h2 class="post-title">{post.frontmatter.title}</h2>
                        </a>
                        {post.frontmatter.description && <p class="post-excerpt">{post.frontmatter.description}</p>}
                        {post.frontmatter.tags && (
                            <div class="post-tags">
                                {post.frontmatter.tags.map((tag: string) => (
                                    <button class="tag tag-btn" data-tag={tag}>#{tag}</button>
                                ))}
                            </div>
                        )}
                    </div>
                    {post.frontmatter.heroImage && (
                        <a href={post.url} class="post-thumb-wrapper">
                            <img src={post.frontmatter.heroImage} alt={post.frontmatter.title} class="post-thumb" />
                        </a>
                    )}
                </article>
            ))
        )}
        <div id="no-results" class="empty-state" style="display: none;">검색 결과가 없습니다.</div>
    </div>

    {posts.length > 0 && (
        <div class="post-controls">
            <input type="text" id="post-search" placeholder="글 제목, 태그 검색..." autocomplete="off" />
        </div>
    )}

    <div class="pagination" id="pagination-container"></div>
</div>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const ITEMS_PER_PAGE = 5; 
        const searchInput = document.getElementById('post-search');
        const postItems = Array.from(document.querySelectorAll('.post-item'));
        const paginationContainer = document.getElementById('pagination-container');
        const noResults = document.getElementById('no-results');

        if (!postItems.length) return; 

        let currentPage = 1;
        let filteredItems = [...postItems];

        function render() {
            const query = searchInput ? searchInput.value.toLowerCase() : '';

            // 1. 필터링
            filteredItems = postItems.filter(item => {
                const title = (item.dataset.title || '').toLowerCase();
                const tags = (item.dataset.tags || '').toLowerCase();
                return title.includes(query) || tags.includes(query);
            });

            // 2. 페이지네이션 계산
            const totalPages = Math.ceil(filteredItems.length / ITEMS_PER_PAGE);
            if (currentPage > totalPages) currentPage = totalPages || 1;

            const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
            const endIndex = startIndex + ITEMS_PER_PAGE;

            // 3. UI 업데이트
            postItems.forEach(item => {
                item.style.display = 'none';
            });
            
            if (filteredItems.length === 0) {
                if (noResults) noResults.style.display = 'block';
                if (paginationContainer) paginationContainer.innerHTML = '';
            } else {
                if (noResults) noResults.style.display = 'none';
                filteredItems.slice(startIndex, endIndex).forEach(item => {
                    item.style.display = 'flex'; 
                });
                renderPagination(totalPages);
            }
        }

        function renderPagination(totalPages) {
            if (!paginationContainer) return;
            if (totalPages <= 1) {
                paginationContainer.innerHTML = '';
                return;
            }

            let html = '';
            html += `<button class="page-btn nav-btn" data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''}>&lt;</button>`;
            
            for (let i = 1; i <= totalPages; i++) {
                html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
            }

            html += `<button class="page-btn nav-btn" data-page="${currentPage + 1}" ${currentPage === totalPages ? 'disabled' : ''}>&gt;</button>`;
            
            paginationContainer.innerHTML = html;

            paginationContainer.querySelectorAll('.page-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    if (btn.hasAttribute('disabled')) return;
                    currentPage = parseInt(e.target.dataset.page);
                    render();
                    
                    const listWrapper = document.querySelector('.lucode-post-list-wrapper');
                    if (listWrapper) {
                        const top = listWrapper.getBoundingClientRect().top + window.scrollY - 100;
                        window.scrollTo({ top, behavior: 'smooth' });
                    }
                });
            });
        }

        if (searchInput) {
            const params = new URLSearchParams(window.location.search);
            const q = params.get('q');
            if (q) {
                searchInput.value = q;
            }
            
            searchInput.addEventListener('input', () => { 
                currentPage = 1; 
                render(); 
            });
        }

        document.querySelectorAll('.tag-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                
                const tag = btn.getAttribute('data-tag');
                
                if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
                    if (searchInput) {
                        searchInput.value = tag;
                        searchInput.dispatchEvent(new Event('input'));
                        window.history.pushState({}, '', `/?q=${tag}`);
                        
                        const listWrapper = document.querySelector('.lucode-post-list-wrapper');
                        if (listWrapper) {
                            const top = listWrapper.getBoundingClientRect().top + window.scrollY - 100;
                            window.scrollTo({ top, behavior: 'smooth' });
                        }
                    }
                } else {
                    window.location.href = `/?q=${tag}`;
                }
            });
        });

        render();
    });
</script>

<style>
    .lucode-post-list-wrapper {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .post-controls {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }
    .post-controls input {
        padding: 0.4rem 0.8rem;
        border: 1px solid var(--border-color);
        background: transparent;
        border-radius: var(--radius);
        color: var(--foreground);
        font-family: inherit;
        font-size: 0.8rem;
        outline: none;
        transition: border-color 0.15s;
        width: 100%;
        max-width: 400px;
    }
    .post-controls input:focus {
        border-color: var(--foreground);
    }

    .lucode-post-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .post-item {
        position: relative;
        display: none; 
        flex-direction: row;
        align-items: center; /* Changed from flex-start to center for better alignment */
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.5rem 0; /* Only vertical padding */
        margin: 0;
        border-bottom: 1px solid var(--border-color);
    }
    .post-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .post-content-wrapper {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    
    .empty-state {
        color: var(--muted-foreground);
        font-size: 0.875rem;
        padding: 2rem 0;
    }
    
    .post-date {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--muted-foreground);
    }
    
    .post-thumb-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 160px;
        height: 100px;
        margin: 0;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid var(--border-color);
        transition: border-color 0.15s;
    }
    .post-thumb-wrapper:hover {
        border-color: var(--signature-color);
    }
    
    .post-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        margin: 0;
    }
    
    .post-link {
        text-decoration: none;
        color: var(--foreground);
        display: inline-block; /* Allows the link to fit tightly around the text */
        width: max-content;
    }
    .post-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0;
        line-height: 1.3;
        letter-spacing: var(--tracking-tight);
        transition: color 0.15s;
    }
    .post-link:hover .post-title {
        color: var(--signature-color);
    }
    
    .post-excerpt {
        color: var(--muted-foreground);
        font-size: 0.9375rem;
        line-height: 1.5;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .post-tags {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.25rem;
        flex-wrap: wrap;
    }
    .tag {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--signature-color);
        padding: 0.15rem 0.5rem;
        border-radius: 0.25rem;
        background-color: transparent;
        border: 1px solid var(--signature-color);
        cursor: pointer;
        transition: background-color 0.15s, color 0.15s;
    }
    .tag:hover {
        background-color: var(--signature-color);
        color: var(--bg-color);
    }

    @media (max-width: 600px) {
        .post-item {
            gap: 1rem;
        }
        .post-thumb-wrapper {
            width: 100px;
            height: 80px;
        }
    }

    :global(.pagination) {
        display: flex;
        justify-content: center;
        gap: 0.25rem;
        margin-top: 1rem; /* Reduced top margin */
    }
    :global(.page-btn) {
        background: transparent;
        border: none;
        color: var(--muted-foreground);
        cursor: pointer;
        font-family: inherit;
        font-size: 0.875rem;
        padding: 0.375rem 0.75rem;
        border-radius: var(--radius);
        transition: color 0.15s, background-color 0.15s;
    }
    :global(.page-btn:hover:not([disabled])) {
        color: var(--foreground);
        background-color: var(--muted);
    }
    :global(.page-btn.active) {
        color: var(--foreground);
        background-color: var(--muted);
        font-weight: 500;
    }
    :global(.page-btn[disabled]) {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>