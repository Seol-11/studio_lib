---
export interface Props {
    posts: import('../utils/posts').MarkdownPost[];
    subCategories?: string[];
}

const { posts, subCategories = [] } = Astro.props;

// 각 서브 카테고리별 글 개수 계산
const subCategoryCounts = subCategories.reduce((acc, cat) => {
    acc[cat] = posts.filter(p => p.subCategory === cat).length;
    return acc;
}, {} as Record<string, number>);

const totalCount = posts.length;
const instanceId = `post-search-${Astro.url.pathname.replace(/[^a-zA-Z0-9]+/g, '-') || 'home'}`;
---

<div class="lucode-post-list-wrapper" data-post-list>
    {subCategories.length > 0 && (
        <div class="subcategory-filter">
            <button class="subcat-btn active" data-subcat="all">
                All Posts <span class="count">({totalCount})</span>
            </button>
            {subCategories.map(cat => (
                <button class="subcat-btn" data-subcat={cat}>
                    {cat} <span class="count">({subCategoryCounts[cat] || 0})</span>
                </button>
            ))}
        </div>
    )}

    <div class="lucode-post-list">
        {posts.length === 0 ? (
            <p class="empty-state">아직 작성된 글이 없습니다.</p>
        ) : (
            posts.map(post => (
                <article 
                    class="post-item" 
                    data-title={post.frontmatter.title} 
                    data-tags={(post.frontmatter.tags || []).join(',')}
                    data-subcat={post.subCategory || ''}
                >
                    <div class="post-content-wrapper">
                        <time class="post-date" datetime={post.frontmatter.date ? new Date(post.frontmatter.date).toISOString() : undefined}>
                            {post.frontmatter.date ? new Date(post.frontmatter.date).toISOString().split('T')[0] : 'No Date'}
                        </time>
                        <a href={post.url} class="post-link">
                            <h2 class="post-title">{post.frontmatter.title}</h2>
                        </a>
                        {post.frontmatter.description && <p class="post-excerpt">{post.frontmatter.description}</p>}
                        {post.frontmatter.tags && (
                            <div class="post-tags">
                                {post.frontmatter.tags.map((tag: string) => (
                                    <button class="tag tag-btn" data-tag={tag}>#{tag}</button>
                                ))}
                            </div>
                        )}
                    </div>
                    {post.frontmatter.thumbnailImage && (
                        <a href={post.url} class="post-thumb-wrapper">
                            <img src={post.frontmatter.thumbnailImage} alt="" class="post-thumb" width="1200" height="676" loading="lazy" decoding="async" />
                        </a>
                    )}
                </article>
            ))
        )}
        <div class="empty-state no-results" hidden>검색 결과가 없습니다.</div>
    </div>

    {posts.length > 0 && (
        <div class="post-controls">
            <label class="sr-only" for={instanceId}>게시글 검색</label>
            <input type="search" id={instanceId} class="post-search" placeholder="글 제목, 태그 검색..." autocomplete="off" />
        </div>
    )}

    <nav class="pagination" aria-label="게시글 페이지"></nav>
</div>

<script>
    import { renderPagination } from '../utils/pagination';

    const initPostList = () => {
        document.querySelectorAll<HTMLElement>('[data-post-list]').forEach((wrapper) => {
            if (wrapper.dataset.initialized === 'true') return;
            wrapper.dataset.initialized = 'true';
            const ITEMS_PER_PAGE = 5;
            const searchInput = wrapper.querySelector<HTMLInputElement>('.post-search');
            const postItems = Array.from(wrapper.querySelectorAll<HTMLElement>('.post-item'));
            const paginationContainer = wrapper.querySelector<HTMLElement>('.pagination');
            const noResults = wrapper.querySelector<HTMLElement>('.no-results');
            if (!postItems.length || !paginationContainer) return;

            let currentPage = 1;
            let currentSubcat = 'all';

            const render = () => {
                const query = searchInput?.value.trim().toLocaleLowerCase('ko') ?? '';
                const filteredItems = postItems.filter((item) => {
                    const inCategory = currentSubcat === 'all' || item.dataset.subcat === currentSubcat;
                    const searchable = `${item.dataset.title ?? ''} ${item.dataset.tags ?? ''}`.toLocaleLowerCase('ko');
                    return inCategory && (!query || searchable.includes(query));
                });
                const totalPages = Math.ceil(filteredItems.length / ITEMS_PER_PAGE);
                currentPage = Math.min(currentPage, totalPages || 1);
                postItems.forEach((item) => { item.style.display = 'none'; });
                filteredItems.slice((currentPage - 1) * ITEMS_PER_PAGE, currentPage * ITEMS_PER_PAGE)
                    .forEach((item) => { item.style.display = 'flex'; });
                if (noResults) noResults.hidden = filteredItems.length > 0;
                renderPagination(paginationContainer, currentPage, totalPages, (page) => {
                    currentPage = page;
                    render();
                    window.scrollTo({ top: wrapper.getBoundingClientRect().top + window.scrollY - 100, behavior: 'smooth' });
                });
            };

            if (searchInput) {
            const params = new URLSearchParams(window.location.search);
            const q = params.get('q');
                if (q && !searchInput.value) searchInput.value = q;
                searchInput.addEventListener('input', () => { currentPage = 1; render(); });
            }

            const subcatBtns = wrapper.querySelectorAll<HTMLButtonElement>('.subcat-btn');
            subcatBtns.forEach((button) => button.addEventListener('click', () => {
                const cat = button.dataset.subcat;
                if (!cat) return;
                subcatBtns.forEach((item) => item.classList.toggle('active', item === button));
                currentSubcat = cat;
                currentPage = 1;
                render();
            }));

            wrapper.querySelectorAll<HTMLButtonElement>('.tag-btn').forEach((button) => {
                button.addEventListener('click', (e) => {
                    e.preventDefault();
                    const tag = button.dataset.tag;
                    if (!tag) return;
                    if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
                        if (!searchInput) return;
                        searchInput.value = tag;
                        currentPage = 1;
                        window.history.replaceState({}, '', `/?q=${encodeURIComponent(tag)}`);
                        render();
                    } else {
                        window.location.href = `/?q=${encodeURIComponent(tag)}`;
                    }
                });
            });
            render();
        });
    };

    document.addEventListener('astro:page-load', initPostList);
</script>

<style>
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    .subcategory-filter {
        display: flex;
        gap: 0.35rem; /* Slightly tighter gap since prefix is gone */
        flex-wrap: wrap;
        width: 100%;
        margin-top: 2rem;
        margin-bottom: -1rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
        border-bottom: none;
    }

    .subcat-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--foreground);
        padding: 0.3rem 0.6rem;
        border-radius: var(--radius);
        font-size: var(--font-size-code);
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        transition: all var(--transition-fast);
        opacity: 0.85; /* Keep it very clear but slightly less than active */
    }

    .subcat-btn:hover {
        background-color: var(--muted);
        opacity: 1;
    }

    .subcat-btn.active {
        color: var(--foreground);
        background-color: var(--muted);
        opacity: 1;
        font-weight: 700;
    }

    .subcat-btn .count {
        font-size: var(--font-size-meta);
        opacity: 0.45;
        margin-left: 0.2rem;
        font-weight: 400;
    }

    .subcat-btn.active .count {
        opacity: 0.7;
    }

    .lucode-post-list-wrapper {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .post-controls {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .post-controls input {
        padding: 0.4rem 0.8rem;
        border: 1px solid var(--border-color);
        background: transparent;
        border-radius: var(--radius);
        color: var(--foreground);
        font-family: inherit;
        font-size: var(--font-size-sidebar);
        outline: none;
        transition: border-color 0.15s;
        width: 100%;
        max-width: 400px;
    }
    .post-controls input:focus {
        border-color: var(--foreground);
    }

    .lucode-post-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .post-item {
        position: relative;
        display: none; 
        flex-direction: row;
        align-items: flex-start;
        justify-content: space-between;
        gap: clamp(1rem, 3vw, 1.5rem);
        padding: 1.5rem 0; 
        margin: 0;
        border-bottom: 1px solid var(--border-color);
    }

    .post-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .post-content-wrapper {
        flex: 1 1 72%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    
    .empty-state {
        color: var(--muted-foreground);
        font-size: var(--size-sm);
        padding: 2rem 0;
    }
    
    .post-date {
        font-family: var(--font-mono);
        font-size: var(--size-xs);
        color: var(--muted-foreground);
    }
    
    .post-thumb-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 1 28%;
        width: 140px;
        max-width: 140px;
        aspect-ratio: 16 / 10;
        margin: 0;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid var(--border-color);
        transition: border-color 0.15s;
    }
    .post-thumb-wrapper:hover {
        border-color: var(--signature-color);
    }
    
    .post-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        margin: 0;
    }
    
    .post-link {
        text-decoration: none;
        color: var(--foreground);
        display: block; 
        width: 100%; 
    }
    .post-title {
        font-size: var(--font-size-h2);
        font-weight: var(--weight-semibold);
        margin: 0;
        line-height: 1.3;
        letter-spacing: var(--tracking-tight);
        transition: color var(--transition-fast);
    }
    .post-link:hover .post-title {
        color: var(--signature-color);
    }
    
    .post-excerpt {
        color: var(--muted-foreground);
        font-size: var(--font-size-list-desc);
        line-height: 1.5;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .post-tags {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.25rem;
        flex-wrap: nowrap;
        overflow: hidden;
    }
    .tag {
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: var(--font-size-tag);
        color: var(--signature-color);
        padding: 0.15rem 0.5rem;
        border-radius: 0.25rem;
        background-color: transparent;
        border: 1px solid var(--signature-color);
        cursor: pointer;
        transition: background-color 0.15s, color 0.15s;
    }
    .tag:hover {
        background-color: var(--signature-color);
        color: var(--bg-color);
    }

    @media (max-width: 600px) {
        .post-item {
            gap: 0.75rem;
        }
        .post-thumb-wrapper {
            flex-basis: 88px;
            width: 88px;
            max-width: 88px;
            aspect-ratio: 4 / 3;
        }
        .post-title {
            font-size: 1.1rem;
            line-height: 1.35;
        }
        .post-excerpt {
            font-size: 0.85rem;
            -webkit-line-clamp: 2;
        }
        .tag {
            font-size: 0.7rem;
            padding: 0.1rem 0.4rem;
        }
    }

    @media (max-width: 420px) {
        .post-thumb-wrapper {
            display: none;
        }
    }
</style>
