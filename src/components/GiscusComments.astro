---
// src/components/GiscusComments.astro
import { GISCUS } from '../config/site';
---

<div class="giscus-wrapper" data-repo={GISCUS.repo} data-repo-id={GISCUS.repoId} data-category={GISCUS.category} data-category-id={GISCUS.categoryId}>
    <div class="giscus"></div>
</div>

<script>
    let giscusObserver: MutationObserver | undefined;

    function getGiscusTheme() {
        return document.documentElement.classList.contains('dark') ? 'gruvbox_dark' : 'light';
    }

    function loadGiscus() {
        const script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        const wrapper = document.querySelector<HTMLElement>('.giscus-wrapper');
        if (!wrapper) return;
        script.setAttribute('data-repo', wrapper.dataset.repo ?? '');
        script.setAttribute('data-repo-id', wrapper.dataset.repoId ?? '');
        script.setAttribute('data-category', wrapper.dataset.category ?? '');
        script.setAttribute('data-category-id', wrapper.dataset.categoryId ?? '');
        script.setAttribute('data-mapping', 'pathname');
        script.setAttribute('data-strict', '0');
        script.setAttribute('data-reactions-enabled', '0');
        script.setAttribute('data-emit-metadata', '0');
        script.setAttribute('data-input-position', 'bottom');
        script.setAttribute('data-theme', getGiscusTheme());
        script.setAttribute('data-lang', 'ko');
        script.setAttribute('crossorigin', 'anonymous');
        script.async = true;

        const container = document.querySelector('.giscus');
        if (container) {
            container.innerHTML = '';
            container.appendChild(script);
        }
    }

    // 테마 변경 감지 로직 (한 번만 등록)
    if (!giscusObserver) {
        giscusObserver = new MutationObserver(() => {
            const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
            if (!iframe) return;
            iframe.contentWindow?.postMessage(
                { giscus: { setConfig: { theme: getGiscusTheme() } } },
                'https://giscus.app'
            );
        });
        giscusObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    }

    // 초기 로드 및 페이지 전환 시 실행
    document.addEventListener('astro:page-load', loadGiscus);
</script>

<style>
    .giscus-wrapper {
        width: 100%;
        margin-top: 1rem;
    }
</style>
