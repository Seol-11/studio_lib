---
// src/components/Header.astro
---
<header class="sys-header">
    <div class="header-inner">
        <div class="nav-left">
            <a href="/" class="brand">Studio.lib</a>
        </div>
        
        <div class="nav-right">
            <nav class="main-nav">
                <a href="/" class="nav-item">Blog</a>
                <a href="/about" class="nav-item">About</a>
            </nav>
            
            <button id="search-btn" class="search-btn" aria-label="Search">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </button>

            <button id="theme-toggle-header" class="theme-toggle-btn" aria-label="Toggle Dark Mode">
                <svg class="sun" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="18.36" x2="5.64" y2="16.92"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                <svg class="moon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>

            <!-- Mobile Menu Toggle -->
            <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
        </div>
    </div>
</header>

<!-- Search Modal -->
<div id="search-modal" class="search-modal">
    <div class="search-modal-backdrop"></div>
    <div class="search-modal-content">
        <div class="search-input-wrapper">
            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="search-input" placeholder="Search posts..." autocomplete="off" />
            <button id="close-search" class="close-search-btn">ESC</button>
        </div>
        <div id="search-results" class="search-results">
            <div class="search-empty">Type to start searching...</div>
        </div>
    </div>
</div>

<script>
    import Fuse from 'fuse.js';

    const initHeader = () => {
        // Theme Toggle
        const toggleBtn = document.getElementById("theme-toggle-header");
        if (toggleBtn) {
            const newBtn = toggleBtn.cloneNode(true);
            toggleBtn.parentNode?.replaceChild(newBtn, toggleBtn);
            
            newBtn.addEventListener("click", () => {
                document.documentElement.classList.add('theme-toggling');
                const isNowDark = document.documentElement.classList.toggle("dark");
                localStorage.setItem("theme", isNowDark ? "dark" : "light");
                setTimeout(() => {
                    document.documentElement.classList.remove('theme-toggling');
                }, 50);
            });
        }
        
        // Active Menu Highlight
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        const navItems = document.querySelectorAll('.nav-item');
        
        navItems.forEach(item => {
            const href = (item.getAttribute('href') || '').replace(/\/$/, '') || '/';
            item.classList.remove('active');
            
            if (href === '/about') {
                if (currentPath.startsWith('/about')) {
                    item.classList.add('active');
                }
            } else if (href === '/') {
                if (currentPath === '/' || (!currentPath.startsWith('/about') && !currentPath.startsWith('/log') && !currentPath.startsWith('/study') && !currentPath.startsWith('/projects'))) {
                    item.classList.add('active');
                }
            } else {
                if (currentPath.startsWith(href)) {
                    item.classList.add('active');
                }
            }
        });

        // Mobile Menu Logic
        const mobileBtn = document.getElementById('mobile-menu-btn');
        if (mobileBtn) {
            const newMobileBtn = mobileBtn.cloneNode(true);
            mobileBtn.parentNode?.replaceChild(newMobileBtn, mobileBtn);

            newMobileBtn.addEventListener('click', () => {
                const leftSidebar = document.querySelector('.lucode-sidebar') || document.querySelector('.left-sidebar');
                if (leftSidebar) {
                    leftSidebar.classList.toggle('mobile-open');
                }
            });
        }

        // Search Logic
        const searchBtn = document.getElementById('search-btn');
        const searchModal = document.getElementById('search-modal');
        const closeSearchBtn = document.getElementById('close-search');
        const searchInput = document.getElementById('search-input');
        const searchResults = document.getElementById('search-results');
        const backdrop = document.querySelector('.search-modal-backdrop');

        let searchData: any[] | null = null;
        let fuse: Fuse<any> | null = null;

        const openSearch = async () => {
            if (!searchModal) return;
            searchModal.classList.add('active');
            searchInput?.focus();
            document.body.style.overflow = 'hidden';
            
            if (!searchData) {
                try {
                    const res = await fetch('/search.json');
                    searchData = await res.json();
                    fuse = new Fuse(searchData as any[], {
                        keys: [
                            { name: 'title', weight: 0.7 },
                            { name: 'tags', weight: 0.5 },
                            { name: 'description', weight: 0.3 }
                        ],
                        threshold: 0.3,
                        ignoreLocation: true
                    });
                } catch (e) {
                    console.error('Failed to load search data', e);
                }
            }
        };

        const closeSearch = () => {
            if (!searchModal) return;
            searchModal.classList.remove('active');
            document.body.style.overflow = '';
            if (searchInput) (searchInput as HTMLInputElement).value = '';
            if (searchResults) searchResults.innerHTML = '<div class="search-empty">Type to start searching...</div>';
        };

        if (searchBtn) {
            const newSearchBtn = searchBtn.cloneNode(true);
            searchBtn.parentNode?.replaceChild(newSearchBtn, searchBtn);
            newSearchBtn.addEventListener('click', openSearch);

            if (closeSearchBtn) {
                const newCloseBtn = closeSearchBtn.cloneNode(true);
                closeSearchBtn.parentNode?.replaceChild(newCloseBtn, closeSearchBtn);
                newCloseBtn.addEventListener('click', closeSearch);
            }

            if (backdrop) {
                const newBackdrop = backdrop.cloneNode(true);
                backdrop.parentNode?.replaceChild(newBackdrop, backdrop);
                newBackdrop.addEventListener('click', closeSearch);
            }

            const handleKeydown = (e: KeyboardEvent) => {
                if (e.key === 'Escape' && document.getElementById('search-modal')?.classList.contains('active')) {
                    closeSearch();
                }
                if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                    e.preventDefault();
                    openSearch();
                }
            };
            window.removeEventListener('keydown', handleKeydown);
            window.addEventListener('keydown', handleKeydown);

            if (searchInput) {
                const newSearchInput = searchInput.cloneNode(true) as HTMLInputElement;
                searchInput.parentNode?.replaceChild(newSearchInput, searchInput);
                
                newSearchInput.addEventListener('input', (e) => {
                    const query = (e.target as HTMLInputElement).value;
                    const resultsContainer = document.getElementById('search-results');
                    if (!resultsContainer) return;

                    if (!query) {
                        resultsContainer.innerHTML = '<div class="search-empty">Type to start searching...</div>';
                        return;
                    }
                    if (!fuse) return;

                    const fuseResults = fuse.search(query);
                    const results = fuseResults.map((r: any) => r.item);

                    if (results.length === 0) {
                        resultsContainer.innerHTML = '<div class="search-empty">No results found for "'+query+'"</div>';
                        return;
                    }

                    resultsContainer.innerHTML = results.map((item: any) => `
                        <a href="${item.url}" class="search-result-item">
                            <div class="search-result-title">${item.title}</div>
                            <div class="search-result-desc">${item.description}</div>
                        </a>
                    `).join('');
                });
            }
        }
    };

    document.addEventListener('astro:page-load', initHeader);
</script>

<style>
    /* Header Styles */
    .sys-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background: var(--bg-color);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border-color);
        border-top: 3px solid var(--signature-color);
        z-index: 1000;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: background-color var(--transition-normal);
    }

    .header-inner {
        width: 100%;
        max-width: var(--container-max-width);
        height: var(--header-height);
        padding: 0 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .brand {
        font-family: var(--font-mono);
        font-weight: 800;
        font-size: 1.2rem;
        color: var(--foreground);
        text-decoration: none;
        letter-spacing: -0.5px;
        transition: color var(--transition-fast);
    }
    .brand:hover {
        color: var(--signature-color);
    }

    .nav-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-left: 0.5rem; /* Aligns with sidebar category items */
    }

    .nav-right {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .main-nav {
        display: flex;
        gap: 1.5rem;
    }

    .nav-item {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--muted-foreground);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: color var(--transition-fast);
    }

    .nav-item:hover, .nav-item.active {
        color: var(--signature-color);
        font-weight: 700;
    }

    .search-btn, .theme-toggle-btn, .mobile-menu-btn {
        background: none;
        border: none;
        color: var(--muted-foreground);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.4rem;
        border-radius: var(--radius);
        transition: color var(--transition-fast), background var(--transition-fast);
    }

    .search-btn:hover, .theme-toggle-btn:hover, .mobile-menu-btn:hover {
        color: var(--foreground);
        background: var(--muted);
    }

    .mobile-menu-btn {
        display: none;
    }

    .sun { display: block; } .moon { display: none; }
    :global(html.dark) .sun { display: none; }
    :global(html.dark) .moon { display: block; }

    /* Search Modal Styles */
    .search-modal {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        z-index: var(--z-modal);
        display: none;
        align-items: flex-start;
        justify-content: center;
        padding-top: 10vh;
    }
    .search-modal.active {
        display: flex;
    }
    .search-modal-backdrop {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: var(--overlay-bg);
        backdrop-filter: blur(4px);
    }
    .search-modal-content {
        position: relative;
        width: 100%;
        max-width: var(--modal-max-width);
        background: var(--bg-color);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: var(--shadow-xl);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        margin: 0 var(--space-md);
    }

    .search-input-wrapper {
        display: flex;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }
    .search-icon {
        color: var(--muted-foreground);
        margin-right: 1rem;
    }
    .search-input-wrapper input {
        flex: 1;
        background: transparent;
        border: none;
        font-size: 1.1rem;
        color: var(--foreground);
        outline: none;
        font-family: var(--font-sans);
    }
    .close-search-btn {
        background: var(--muted);
        border: none;
        color: var(--muted-foreground);
        font-size: 0.7rem;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        cursor: pointer;
        font-family: var(--font-mono);
    }
    .search-results {
        max-height: 400px;
        overflow-y: auto;
        padding: 1rem 0;
        background: var(--bg-color);
    }
    :global(.search-empty) {
        padding: 2rem;
        text-align: center;
        color: var(--muted-foreground);
        font-size: 0.9rem;
    }
    :global(.search-result-item) {
        display: block;
        padding: 0.8rem 1.5rem;
        text-decoration: none !important;
        color: var(--foreground) !important;
        background: transparent;
        border-left: 3px solid transparent;
        transition: background 0.2s, border-color 0.2s;
    }
    :global(.search-result-item:hover) {
        background: var(--muted);
        border-left-color: var(--foreground);
        color: var(--foreground) !important;
        text-decoration: none !important;
    }
    :global(.search-result-title) {
        color: var(--foreground);
        font-weight: 700;
        margin-bottom: 0.2rem;
        text-decoration: none !important;
        display: block;
    }
    :global(.search-result-desc) {
        color: var(--muted-foreground);
        font-size: 0.85rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-decoration: none !important;
        display: block;
    }

    @media (max-width: 768px) {
        .main-nav { display: none; }
        .mobile-menu-btn { display: flex; }
        .header-inner { padding: 0 1rem; }
        .nav-right { gap: 0.5rem; }
        .nav-left { margin-left: 0; }
    }
</style> }
    }
</style>