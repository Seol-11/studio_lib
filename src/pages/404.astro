---
import BlogLayout from '../layouts/BlogLayout.astro';
---

<BlogLayout title="페이지를 찾을 수 없습니다 | Studio.lib" description="요청한 페이지를 찾을 수 없습니다." robots="noindex, nofollow">
    <section class="not-found sl-markdown-content">
        <p class="error-code">404</p>
        <h1>페이지를 찾을 수 없습니다.</h1>
        <p>주소가 변경되었거나 삭제된 페이지입니다.</p>
        <a href="/" class="home-link">블로그 홈으로 돌아가기</a>
    </section>
</BlogLayout>

<style>
    .not-found { padding: 4rem 0; text-align: center; }
    .error-code { margin: 0; color: var(--signature-color); font: 700 4rem/1 var(--font-mono); }
    .not-found h1 { margin: 1rem 0; }
    .home-link { display: inline-block; margin-top: 1.5rem; color: var(--signature-color); }
</style>
