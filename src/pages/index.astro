---
import BlogLayout from '../layouts/BlogLayout.astro';
import PostList from '../components/PostList.astro';
import * as BlogIndex from './_blog-index.md';

// pages 디렉토리 내부의 모든 마크다운 파일을 가져옵니다.
const allPosts = Object.values(import.meta.glob('./**/*.md', { eager: true })) as any[];

// 메인 화면용, 카테고리용 마크다운 파일은 포스트 목록에서 제외합니다.
const posts = allPosts.filter(post => !post.file.endsWith('_blog-index.md') && !post.frontmatter.isCategory);

// 날짜 기준으로 내림차순 정렬 (최신 글이 위로)
const sortedPosts = posts.sort((a, b) => {
    const dateA = new Date(a.frontmatter.date || 0).valueOf();
    const dateB = new Date(b.frontmatter.date || 0).valueOf();
    return dateB - dateA;
});
---

<BlogLayout title="Blog | Studio.lib">
    <div class="sl-markdown-content">
        <header class="category-header">
            <h1 class="category-title" id="_top">{BlogIndex.frontmatter.title}</h1>
            {BlogIndex.frontmatter.description && <p class="category-meta">{BlogIndex.frontmatter.description}</p>}
        </header>

        <div class="blog-index-content">
            <BlogIndex.Content />
        </div>

        <div class="category-posts-section">
            <h2 id="recent-posts">Recent Posts</h2>
            <PostList posts={sortedPosts} />
        </div>
    </div>
</BlogLayout>

<style>
    .category-header {
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
    }
    .category-title {
        font-size: 1.75rem !important; /* Slightly increased from 1.625rem */
        font-weight: 600 !important;
        margin: 0 0 0.5rem 0 !important;
        letter-spacing: var(--tracking-tight) !important;
    }
    .category-meta {
        color: var(--muted-foreground);
        font-size: 0.9375rem;
        margin: 0 !important;
    }

    .blog-index-content {
        margin-bottom: 0.5rem;
    }

    .category-posts-section {
        margin-top: 0;
        padding-top: 0;
    }

    @media (max-width: 600px) {
        .category-title {
            font-size: 1.5rem !important;
        }
        .category-header {
            margin-bottom: 0.75rem;
            padding-bottom: 0.25rem;
        }
    }
</style>