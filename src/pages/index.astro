---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Studio.lib | System Router">
    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode">
        <svg class="sun" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="18.36" x2="5.64" y2="16.92"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="moon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>

    <div class="viewport-wrapper">
        <div class="background-blobs">
            <div class="blob b1"></div>
            <div class="blob b2"></div>
            <div class="blob b3"></div>
        </div>
            
        <main class="schematic-container">
            <header class="schematic-header">
                <h1>Studio.lib</h1>
                <p class="subtitle">Digital Logic & Analog Log</p>
            </header>

            <nav class="schematic-grid">
                <a href="/cv" class="schematic-node">
                    <div class="node-data">
                        <span class="node-title">CV_PORTFOLIO</span>
                        <span class="node-desc">Hardware architectures</span>
                    </div>
                </a>
                <a href="/blog" class="schematic-node">
                    <div class="node-data">
                        <span class="node-title">ANALOG_LOG</span>
                        <span class="node-desc">Blog & Study Notes</span>
                    </div>
                </a>
                <a href="#" class="schematic-node disabled" onclick="event.preventDefault();">
                    <div class="node-data">
                        <span class="node-title">EMPTY_SLOT</span>
                        <span class="node-desc">Reserved for future use</span>
                    </div>
                </a>
                <a href="https://github.com/seol-11" target="_blank" rel="noopener noreferrer" class="schematic-node">
                    <div class="node-data">
                        <span class="node-title">GITHUB_REPO</span>
                        <span class="node-desc">Source codes & controls</span>
                    </div>
                </a>
            </nav>

            <footer class="sys-footer">
                <div class="footer-brand">© 2026 STUDIO.LIB</div>
                <div class="footer-meta"><span>v1.0.0</span></div>
            </footer>
        </main>
    </div>
</BaseLayout>

<script is:inline>
    document.addEventListener('astro:page-load', () => {
        const toggleBtn = document.getElementById("theme-toggle");
        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

        const listener = (e) => {
            if (!localStorage.getItem('theme')) {
                document.documentElement.classList.toggle('dark', e.matches);
            }
        };

        mediaQuery.addEventListener('change', listener);

        if (toggleBtn && !toggleBtn.dataset.init) {
            toggleBtn.dataset.init = "true";
            toggleBtn.addEventListener("click", () => {
                const isNowDark = document.documentElement.classList.toggle("dark");
                localStorage.setItem("theme", isNowDark ? "dark" : "light");
            });
        }
    });
</script>

<style>
    :root {
        --bg-color: #FDFCF8;
        --blob-1: #FFE5D9;
        --blob-2: #E8F1F2;
        --blob-3: #F4F1DE;
        --container-bg: rgba(255, 255, 255, 0.6);
        --border-glow: 0 0 0 transparent; 
        --glow-color: rgba(0, 0, 0, 0.08); 
        --shadow-color: rgba(0, 0, 0, 0.05);
        --text-primary: #111;
        --text-secondary: #666;
        --border-color: rgba(0, 0, 0, 0.08);

        --transition-speed: 0.4s;
        --hover-offset: 12px;
        --noise-opacity: 0.04;
        --noise-bg: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    :global(html.dark) {
        --bg-color: #121212; 
        --blob-1: #232127;
        --blob-2: #2f3036;
        --blob-3: #24262b;   
        --container-bg: rgba(30, 30, 30, 0.6); 
        --border-glow: 0 0 0 transparent; 
        --glow-color: rgba(0, 0, 0, 0.3); 
        --shadow-color: rgba(0, 0, 0, 0.4);
        --text-primary: #EEEEEE; 
        --text-secondary: #999999; 
        --border-color: rgba(255, 255, 255, 0.08); 
        --noise-opacity: 0.02; 
    }

    :global(body) {
        background: var(--bg-color);
        transition: background-color var(--transition-speed) ease;
    }

    :global(body::after) {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background-image: var(--noise-bg);
        opacity: var(--noise-opacity);
        pointer-events: none;
        z-index: 9999;
    }

    .background-blobs {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        z-index: 0;
        overflow: hidden;
        filter: blur(100px);
        transform: translateZ(0); 
    }

    .blob {
        position: absolute;
        width: 75vw;
        height: 75vw;
        border-radius: 50%;
        opacity: 0.6;
        animation: float 35s infinite alternate ease-in-out;
        transition: background-color 1.5s ease;
        will-change: transform; 
    }

    .b1 { top: -25%; left: -15%; background-color: var(--blob-1); }
    .b2 { bottom: -25%; right: -15%; background-color: var(--blob-2); animation-delay: -5s; }
    .b3 { top: 25%; left: 35%; background-color: var(--blob-3); animation-delay: -10s; }

    @keyframes float {
        0% { transform: translate(0, 0) scale(1) rotate(0deg); }
        100% { transform: translate(10%, 10%) scale(1.1) rotate(5deg); }
    }

    .viewport-wrapper {
        position: relative;
        z-index: 10;
        width: 100%;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        box-sizing: border-box;
    }

    .theme-toggle {
        position: fixed;
        top: 2rem;
        right: 2rem;
        z-index: 100;
        background: var(--container-bg);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        padding: 0.7rem;
        cursor: pointer;
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease, background-color var(--transition-speed) ease;
        border-radius: 50%;
        display: flex;
        box-shadow: 0 4px 12px var(--shadow-color);
    }

    .theme-toggle:hover { transform: scale(1.1); }
    .sun { display: block; } .moon { display: none; }
    :global(html.dark) .sun { display: none; }
    :global(html.dark) .moon { display: block; }

    .schematic-container {
        position: relative; 
        width: 100%;
        max-width: 500px;
        background: var(--container-bg);
        backdrop-filter: blur(40px);
        border: 1px solid var(--border-color);
        padding: 4rem 3rem;
        box-shadow: var(--border-glow), 0 0 40px var(--glow-color), 0 30px 60px var(--shadow-color);
        border-radius: 8px;
        transition: background-color var(--transition-speed) ease, box-shadow var(--transition-speed) ease, border-color var(--transition-speed) ease;
    }

    /* [최적화] 사용되지 않는 .sticker-overlap, .so-1, .so-2 클래스 코드블럭 완전 삭제 */

    .schematic-header { 
        margin-bottom: 3.5rem; 
        text-align: center;
    }

    .schematic-header h1 { 
        font-size: 3rem; 
        font-weight: 800;
        margin: 0; 
        color: var(--text-primary); 
        letter-spacing: -2.5px;
        line-height: 1;
    }

    .subtitle { 
        font-family: 'Inter', sans-serif;
        font-size: 0.75rem; 
        font-weight: 700;
        color: var(--text-secondary); 
        margin-top: 10px; 
        text-transform: uppercase;
        letter-spacing: 3px;
    }

    .schematic-grid { display: flex; flex-direction: column; gap: 0.8rem; }

    .schematic-node {
        display: block;
        text-decoration: none;
        color: var(--text-primary);
        padding: 1.5rem 2rem;
        background: transparent; 
        transition: transform var(--transition-speed) cubic-bezier(0.16, 1, 0.3, 1);
    }

    .schematic-node:hover:not(.disabled) { 
        transform: translateX(var(--hover-offset));
    }
    .schematic-node.disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .node-title {
        display: block;
        font-weight: 700;
        font-size: 1.1rem;
        font-family: 'JetBrains Mono', monospace;
        margin-bottom: 0.2rem;
    }

    .node-desc {
        font-size: 0.8rem;
        color: var(--text-secondary);
        opacity: 0.8;
    }

    .sys-footer {
        margin-top: 4.5rem;
        display: flex;
        justify-content: center; 
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: var(--text-secondary);
        opacity: 0.5;
    }

    @media (max-width: 600px) {
        :root {
            --hover-offset: 5px; 
        }        
        .viewport-wrapper { padding: 0; align-items: stretch; }
        .schematic-container {
            max-width: none; width: 100%; border-radius: 0;
            border-left: none; border-right: none;
            padding: 4rem 1.5rem; display: flex;
            flex-direction: column; justify-content: center;
            box-shadow: none;
        }
        .schematic-header h1 { font-size: 2.2rem; }
        .theme-toggle { top: 1rem; right: 1rem; }
    }
</style>