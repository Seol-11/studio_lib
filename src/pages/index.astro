---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Sticker from '../components/Sticker.astro';
---

<BaseLayout title="Studio.lib | System Router">
    <div class="viewport-wrapper">
        
        <div class="sticker-layer">
            <Sticker type="QC_PASSED" top="15vh" left="10vw" rotate="-15" />
            <Sticker type="LOGIC_GATE" top="70vh" left="12vw" rotate="20" />
            <Sticker type="HIGH_VOLTAGE" top="40vh" left="82vw" rotate="10" />
        </div>

        <main class="schematic-container">
            <div class="schematic-header">
                <div class="coord-marker">X:00 Y:00</div>
                <h1>Studio.lib</h1>
                <p class="subtitle">PROJECT: Digital Logic & Analog Log</p>
            </div>

            <nav class="schematic-grid">
                <a href="/cv" class="schematic-node">
                    <span class="pin">PIN 00</span>
                    <div class="node-data"><strong>CV_PORTFOLIO</strong><br/>Hardware architectures</div>
                </a>
                <a href="/silicon" class="schematic-node">
                    <span class="pin">PIN 01</span>
                    <div class="node-data"><strong>SILICON_ARCHIVE</strong><br/>NoC & Interfaces</div>
                </a>
                <a href="/archive" class="schematic-node">
                    <span class="pin">PIN 10</span>
                    <div class="node-data"><strong>ANALOG_LOG</strong><br/>Loose-leaf binder index</div>
                </a>
                <a href="https://github.com/당신의깃허브아이디" target="_blank" rel="noopener noreferrer" class="schematic-node">
                    <span class="pin">PIN 11</span>
                    <div class="node-data"><strong>GITHUB_REPO</strong><br/>Source codes & controls</div>
                </a>
            </nav>
            <footer class="sys-footer">
                <div class="footer-brand">© 2026 STUDIO.LIB</div>
                <div class="footer-meta">
                    <span>v1.0.0</span>
                    <span class="divider">|</span>
                    <span>Built with Astro</span>
                </div>
            </footer>
        </main>
    </div>
</BaseLayout>

<style>
    /* 1. 전역 모눈종이 배경 설정 */
    :global(body) {
        margin: 0;
        background-color: #F4EBD0;
        background-image: 
            linear-gradient(#E0D5B7 1px, transparent 1px),
            linear-gradient(90deg, #E0D5B7 1px, transparent 1px);
        background-size: 20px 20px;
        font-family: 'Noto Serif KR', serif;
    }

    /* 2. 전역 래퍼: 중앙 정렬 및 스크롤바 오버플로우 방지 */
    .viewport-wrapper {
        position: relative;
        width: 100%;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden; /* 스티커가 화면 밖으로 나갈 때 생기는 가로 스크롤 차단 */
        padding: 2rem;
        box-sizing: border-box;
    }

    /* 3. 스티커 전용 레이어 */
    .sticker-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none; /* 스티커가 클릭 이벤트를 탈취하는 현상 방지 */
        z-index: 5;
    }

    /* 4. 중앙 메인 컨테이너 (라우터 보드) */
    .schematic-container {
        position: relative; 
        width: 100%;
        max-width: 600px;
        min-height: 600px; /* 기본 높이 확보 */
        display: flex;
        flex-direction: column;
        background: rgba(244, 235, 208, 0.95); 
        border: 2px solid #4A3F35;
        padding: 2rem;
        box-shadow: 10px 10px 0px rgba(74, 63, 53, 0.1);
        z-index: 10;
    }
    
    .coord-marker { 
        position: absolute; 
        top: -10px; 
        left: -10px; 
        background: #F4EBD0; 
        padding: 0 5px; 
        font-family: 'JetBrains Mono', monospace; 
        font-size: 0.8rem; 
        color: #8C6F56; 
        border: 1px solid #4A3F35;
        z-index: 20;
    }
    .schematic-header { 
        border-bottom: 2px solid #4A3F35; 
        padding-bottom: 1rem; 
        margin-bottom: 2rem; 
    }
    .schematic-header h1 { 
        font-size: 2.5rem; 
        margin: 0; 
        color: #4A3F35; 
        letter-spacing: -1px;
    }
    .subtitle { 
        font-family: 'JetBrains Mono', monospace; 
        font-size: 0.8rem; 
        color: #8C6F56; 
        margin-top: 5px; 
    }

    .schematic-grid { 
        display: flex; 
        flex-direction: column; 
        gap: 1.2rem; 
    }
    .schematic-node {
        display: flex;
        align-items: center; /* 다시 중앙 정렬로 롤백 */
        text-decoration: none;
        color: #4A3F35;
        border: 1px solid #4A3F35;
        transition: background 0.15s ease-in-out;
        background: rgba(255, 255, 255, 0.5);
        position: relative;
    }
    .schematic-node:hover { 
        background: #4A3F35; 
        color: #F4EBD0; 
    }
    .pin { 
        padding: 1rem; 
        background: #4A3F35; /* 타이틀 색상과 동일하게 설정 */
        color: #F4EBD0; /* 가독성을 위해 밝은 대비색 사용 */
        font-family: 'JetBrains Mono', monospace; 
        font-size: 0.8rem; 
        border-right: 1px solid #4A3F35; 
        min-width: 60px;
        text-align: center;
    }
    .node-data { 
        padding: 0.8rem 1rem; 
        font-size: 0.9rem; 
        font-family: 'JetBrains Mono', monospace; 
        line-height: 1.4;
    }
    .schematic-node:hover .pin { 
        background: #F4EBD0; /* 호버 시 전체 배경색으로 반전 */
        color: #4A3F35; 
    }
    .sys-footer {
        margin-top: auto; /* 푸터를 하단으로 밀어냄 */
        padding-top: 1.5rem;
        border-top: 1px dashed #8C6F56; 
        display: flex;
        justify-content: space-between; 
        align-items: center;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #8C6F56;
    }
    
    .footer-brand {
        font-weight: bold;
        letter-spacing: 0.5px;
    }
    
    .footer-meta {
        display: flex;
        gap: 0.8rem;
        opacity: 0.8;
    }
    
    .divider {
        opacity: 0.5;
    }


    /* 5. 모바일/태블릿 대응 (반응형 예외 처리) */
    @media (max-width: 1000px) {
        /* 뷰포트 너비가 1000px 이하로 좁아질 경우 스티커 숨김 */
        .sticker-layer {
            display: none;
        }
    }

    @media (max-width: 600px) {
        .viewport-wrapper {
            padding: 1rem;
            /* 세로 스크롤 허용, 가로 스크롤 방지 */
            overflow-x: hidden;
            overflow-y: auto;
            align-items: stretch; /* 상하단 꽉 차게 프레임을 화면에 맞춤 */
        }
        
        .schematic-container {
            padding: 1.5rem;
            min-height: calc(100vh - 2rem); /* 모바일에서 화면 높이에 맞춤 */
            box-shadow: 4px 4px 0px rgba(74, 63, 53, 0.1); 
            display: flex;
            flex-direction: column;
        }

        .schematic-header h1 {
            font-size: 2rem; 
        }

        .pin {
            padding: 0.8rem;
            min-width: 50px;
        }

        .node-data {
            padding: 0.6rem 0.8rem;
            font-size: 0.85rem;
        }

        .sys-footer {
            font-size: 0.65rem; /* 모바일에서 한 줄 유지를 위해 폰트 축소 */
            gap: 0.5rem;
        }
    }
</style>