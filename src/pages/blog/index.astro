---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import * as BlogIndex from './_blog-index.md';

// pages/blog 디렉토리 내부의 모든 마크다운 파일을 가져옵니다.
const allPosts = await Astro.glob('./**/*.md');

// 메인 화면용, 카테고리용 마크다운 파일은 포스트 목록에서 제외합니다.
const posts = allPosts.filter(post => !post.file.endsWith('_blog-index.md') && !post.frontmatter.isCategory);

// 날짜 기준으로 내림차순 정렬 (최신 글이 위로)
const sortedPosts = posts.sort((a, b) => {
    const dateA = new Date(a.frontmatter.date || 0).valueOf();
    const dateB = new Date(b.frontmatter.date || 0).valueOf();
    return dateB - dateA;
});
---

<BlogLayout title="Blog | Studio.lib">
    <div class="category-header">
        <h1 class="category-title">{BlogIndex.frontmatter.title}</h1>
        {BlogIndex.frontmatter.description && <p class="category-meta">{BlogIndex.frontmatter.description}</p>}
    </div>

    <div class="blog-index-content">
        <BlogIndex.Content />
    </div>

    <PostList posts={sortedPosts} />
</BlogLayout>

<style>
    .category-header {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }
    .category-title {
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 0.5rem 0;
        letter-spacing: -0.5px;
    }
    .category-meta {
        color: var(--text-secondary);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9rem;
        margin: 0;
    }

    .blog-index-content {
        margin-bottom: 4rem;
        line-height: 1.7;
        font-size: 1.05rem;
        color: var(--text-primary);
    }
    
    :global(.blog-index-content h2) {
        font-size: 1.8rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }
    
    :global(.blog-index-content p) {
        margin-bottom: 1rem;
    }
    
    :global(.blog-index-content a) {
        color: var(--signature-color);
        text-decoration: underline;
        text-underline-offset: 4px;
    }
</style>