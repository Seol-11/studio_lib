---
import BlogLayout from '../../layouts/BlogLayout.astro';

// pages/blog 디렉토리 내부의 모든 마크다운 파일을 가져옵니다.
const posts = await Astro.glob('./*.md');

// 날짜 기준으로 내림차순 정렬 (최신 글이 위로)
const sortedPosts = posts.sort((a, b) => {
    const dateA = new Date(a.frontmatter.date || 0).valueOf();
    const dateB = new Date(b.frontmatter.date || 0).valueOf();
    return dateB - dateA;
});
---

<BlogLayout title="Blog | Studio.lib">
    <div class="post-header">
        <h1 class="post-title">Analog Log</h1>
        <p class="post-meta">일상적인 취미, 음악, 영화부터 가벼운 스터디 노트까지.</p>
    </div>

    <div class="post-list">
        {sortedPosts.length === 0 ? (
            <p class="empty-state">아직 작성된 글이 없습니다. src/pages/blog 폴더에 마크다운(.md) 파일을 추가해보세요!</p>
        ) : (
            sortedPosts.map(post => (
                <article class="post-item">
                    <div class="post-date">{post.frontmatter.date || 'No Date'}</div>
                    <a href={post.url} class="post-link">
                        <h2>{post.frontmatter.title}</h2>
                    </a>
                    {post.frontmatter.description && <p class="post-excerpt">{post.frontmatter.description}</p>}
                    {post.frontmatter.tags && (
                        <div class="post-tags">
                            {post.frontmatter.tags.map((tag: string) => (
                                <span class="tag">#{tag}</span>
                            ))}
                        </div>
                    )}
                </article>
            ))
        )}
    </div>
</BlogLayout>

<style>
    .empty-state {
        color: var(--text-secondary);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9rem;
        padding: 2rem 0;
    }
    .post-header {
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border-color);
    }
    .post-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0 0 0.5rem 0;
        letter-spacing: -1px;
    }
    .post-meta {
        color: var(--text-secondary);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9rem;
        margin: 0;
    }

    .post-list {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .post-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .post-date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .post-link {
        text-decoration: none;
        color: var(--text-primary);
    }

    .post-link h2 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        transition: color 0.2s ease;
    }

    .post-link:hover h2 {
        color: var(--text-secondary);
    }

    .post-excerpt {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0;
    }

    .post-tags {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        padding: 0.2rem 0.5rem;
        background: var(--border-color);
        border-radius: 4px;
        color: var(--text-secondary);
    }
</style>