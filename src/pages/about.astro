---
import BlogLayout from '../layouts/BlogLayout.astro';
import { Content } from './_about.md';
---

<BlogLayout title="About | Studio.lib">
    <article class="sl-markdown-content">
        <header class="category-header">
            <h1 class="category-title" id="_top">About</h1>
            <p class="category-meta">System Router & Digital Logic Portfolio</p>
        </header>

        <div class="about-content">
            <Content />
        </div>
    </article>
</BlogLayout>

<style>
    .about-content {
        margin-top: 2rem;
    }
</style>
